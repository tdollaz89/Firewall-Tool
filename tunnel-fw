def show_diff(old, new):
    lines = list(difflib.unified_diff(strip_header(old).splitlines(), strip_header(new).splitlines(),
                                      NFT_CONF + " (current)", NFT_CONF + " (new)", lineterm="", n=2))
    if not lines:
        ok(f"{NFT_CONF} already matches")
        return False
    for l in lines:
        print("    " + (color("32", l) if l.startswith("+") else color("31", l) if l.startswith("-")
                        else color("36", l) if l.startswith("@@") else l))
    return True


def nft_check(path):
    rc, _, err = run(["nft", "-c", "-f", path])
    return rc == 0, err.strip()


def read_forward():
    try:
        return open("/proc/sys/net/ipv4/ip_forward").read().strip()
    except OSError:
        return None


def foreign_tables():
    rc, out, _ = run(["nft", "list", "tables"])
    ours = {"inet filter", "ip nat"}
    return [l.replace("table ", "", 1).strip() for l in out.splitlines()
            if l.startswith("table ") and l.replace("table ", "", 1).strip() not in ours]


def confirm_or_rollback(backup, timeout, old_fwd):
    restore = f"nft -f '{backup}'"
    if old_fwd is not None:
        restore += f"; sysctl -qw net.ipv4.ip_forward={old_fwd}"
    guard = subprocess.Popen(
        ["/bin/sh", "-c", f"sleep {timeout + 5}; {restore}; logger -t tunnel-fw 'not confirmed: rolled back to {backup}'"],
        start_new_session=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def kill_guard():
        try:
            os.killpg(guard.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass

    print()
    print(color("1;33", "  Rules are LIVE. Open a NEW ssh session now and confirm you can still get in."))
    print(color("1;33", f"  Type 'yes' within {timeout}s to keep them; anything else (or silence / a dropped"))
    print(color("1;33", "  connection) rolls back automatically."))
    sys.stdout.write("  keep? ")
    sys.stdout.flush()
    answer = None
    try:
        ready, _, _ = select.select([sys.stdin], [], [], timeout)
        if ready:
            answer = sys.stdin.readline().strip().lower()
    except (OSError, ValueError):
        pass
    kill_guard()
    if answer == "yes":
        ok("confirmed")
        return True
    print()
    run(["nft", "-f", backup])
    if old_fwd is not None:
        run(["sysctl", "-qw", f"net.ipv4.ip_forward={old_fwd}"])
    bad(f"not confirmed - rolled back to previous ruleset ({backup})")
    return False


def ensure_conntrack(interactive):
    if shutil.which("conntrack"):
        return True
    if interactive and ask_yn("The 'conntrack' tool is missing (needed to clear stale NAT state). Install it", True):
        rc, _, err = run(["apt-get", "install", "-y", "conntrack"])
        if rc == 0:
            ok("installed conntrack")
            return True
        warn(f"apt-get failed: {err.strip()[-200:]}")
    return False


def flush_forward_conntrack(cfg, interactive):
    """Flows that started before the DNAT rules existed stay un-NATed forever while the client keeps
    retrying from the same source port (UDP timeout refreshes). Clear them so the next packet is NATed."""
    if cfg["role"] != "fe" or not cfg.get("forwards"):
        return
    if not ensure_conntrack(interactive):
        warn("skipped conntrack flush; if clients can't connect run: "
             + "; ".join(f"conntrack -D -p {f['proto']} --dport {f['port']}" for f in cfg["forwards"]))
        return
    for f in cfg["forwards"]:
        rc, out, err = run(["conntrack", "-D", "-p", f["proto"], "--dport", str(f["port"])])
        m = re.search(r"(\d+) flow entries", out + err)
        ok(f"cleared {m.group(1) if m else 0} conntrack entries for {f['proto']}/{f['port']} "
           "(clients reconnect automatically)")


def write_atomic(path, text, mode):
    tmp = path + ".tunnel-fw.tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def persist_ip_forward():
    """Make ip_forward=1 survive reboots by editing the system's own sysctl.conf (no extra file).
    An active `net.ipv4.ip_forward=0` is switched to 1; else a commented-out line is uncommented; else one is appended."""
    path = os.path.realpath(SYSCTL_CONF if os.path.exists(SYSCTL_CONF) else "/etc/sysctl.conf")
    try:
        with open(path) as f:
            lines = f.read().splitlines()
        mode = os.stat(path).st_mode & 0o7777
    except FileNotFoundError:
        lines, mode = [], 0o644
    active = re.compile(r"^\s*net\.ipv4\.ip_forward\s*=\s*(\S+)")
    commented = re.compile(r"^\s*#\s*net\.ipv4\.ip_forward\s*=")
    vals = [m.group(1) for m in map(active.match, lines) if m]
    if vals and all(v == "1" for v in vals):
        return None
    if vals:
        lines = ["net.ipv4.ip_forward=1" if active.match(l) else l for l in lines]
    else:
        i = next((i for i, l in enumerate(lines) if commented.match(l)), None)
        if i is None:
            lines.append("net.ipv4.ip_forward=1")
        else:
            lines[i] = "net.ipv4.ip_forward=1"
    write_atomic(path, "\n".join(lines) + "\n", mode)
    return path


def apply(cfg, assume_yes=False, no_rollback=False, timeout=60, interactive=True):
    need_root("applying rules")
    os.makedirs(STATE_DIR, exist_ok=True)
    text = render(cfg)
    cand = os.path.join(STATE_DIR, "candidate.nft")
    write_atomic(cand, text, 0o600)

    head("Validating")
    good, err = nft_check(cand)
    if not good:
        die(f"nft rejected the generated ruleset (nothing changed):\n{err}")
    ok("nft syntax check passed")
    ft = foreign_tables()
    if ft:
        warn(f"these live tables are not managed by tunnel-fw and will be REMOVED: {', '.join(ft)}")
        if shutil.which("docker"):
            warn("docker is installed - its NAT rules will be wiped until docker restarts")
    rc, out, _ = run(["ufw", "status"])
    if "Status: active" in out:
        warn("ufw is active and will fight these rules; consider `ufw disable`")

    head("Changes")
    try:
        old = open(NFT_CONF).read()
    except OSError:
        old = ""
    show_diff(old, text)
    if not assume_yes and not ask_yn("Apply now", True):
        info(f"not applied; candidate left at {cand}")
        return False

    head("Applying")
    ts = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    backup = os.path.join(STATE_DIR, f"backup-{ts}.nft")
    rc, live, _ = run(["nft", "list", "ruleset"])
    write_atomic(backup, "flush ruleset\n" + live, 0o600)
    rollback_ok, berr = nft_check(backup)
    if os.path.exists(NFT_CONF):
        shutil.copy2(NFT_CONF, os.path.join(STATE_DIR, f"nftables.conf-{ts}"))
    if not rollback_ok:
        warn(f"the current live ruleset can't be re-loaded as a backup ({berr.splitlines()[0] if berr else '?'}); "
             "automatic rollback is unavailable")
        if not no_rollback and not assume_yes and not ask_yn("Continue without rollback protection", False):
            return False

    old_fwd = read_forward()
    if wants_forwarding(cfg) and old_fwd != "1":
        run(["sysctl", "-qw", "net.ipv4.ip_forward=1"])
        ok("enabled net.ipv4.ip_forward")

    rc, _, err = run(["nft", "-f", cand])
    if rc != 0:
        if old_fwd is not None:
            run(["sysctl", "-qw", f"net.ipv4.ip_forward={old_fwd}"])
        die(f"nft -f failed (live rules unchanged):\n{err}")
    ok("ruleset loaded")

    guard = rollback_ok and not no_rollback and sys.stdin.isatty()
    if rollback_ok and not no_rollback and not sys.stdin.isatty():
        warn("no terminal for confirmation - rollback guard skipped")
    if guard and not confirm_or_rollback(backup, timeout, old_fwd):
        return False

    write_atomic(NFT_CONF, text, 0o755)
    ok(f"wrote {NFT_CONF}")
    if wants_forwarding(cfg):
        changed = persist_ip_forward()
        ok(f"set net.ipv4.ip_forward=1 in {changed}" if changed else f"net.ipv4.ip_forward=1 already set in {SYSCTL_CONF}")
    if os.path.exists(LEGACY_SYSCTL_FILE):
        os.remove(LEGACY_SYSCTL_FILE)
        ok(f"removed {LEGACY_SYSCTL_FILE} (no longer used)")
    rc, _, err = run(["systemctl", "enable", "nftables"])
    if rc == 0:
        ok("nftables.service enabled (rules load at boot, before networking)")
    else:
        warn(f"couldn't enable nftables.service: {err.strip()}")

    flush_forward_conntrack(cfg, interactive and not assume_yes)

    backups = sorted(glob.glob(os.path.join(STATE_DIR, "backup-*.nft")))
    for b in backups[:-KEEP_BACKUPS]:
        os.remove(b)
    head("Done")
    info("run `tunnel-fw doctor` to check the whole path")
    return True


# --------------------------------------------------------------------------- live state

def wg_peers(dev):
    rc, out, _ = run(["wg", "show", dev, "dump"])
    peers, now = [], time.time()
    for p in [l.split("\t") for l in out.strip().splitlines()[1:]] if rc == 0 else []:
        if len(p) < 5:
            continue
        hs = int(p[4]) if p[4].isdigit() else 0
        host = p[2].rsplit(":", 1)[0].strip("[]") if p[2] != "(none)" else None
        peers.append({"label": p[3], "endpoint": p[2], "host": host, "age": int(now - hs) if hs else None})
    return peers


def openvpn_clients(path):
    """Parse an OpenVPN status file (v1, v2 or v3). None if unreadable."""
    try:
        text = open(path, errors="replace").read()
    except OSError:
        return None
    out, in_v1 = [], False
    for line in text.splitlines():
        f = re.split(r"[,\t]", line)
        if f[0] == "CLIENT_LIST" and len(f) > 2:
            name, real = f[1], f[2]
        elif line.startswith("Common Name,Real Address"):
            in_v1 = True
            continue
        elif line.startswith("ROUTING TABLE"):
            in_v1 = False
            continue
        elif in_v1 and len(f) >= 2:
            name, real = f[0], f[1]
        else:
            continue
        m = re.search(r"(\d+\.\d+\.\d+\.\d+)", real)
        out.append({"label": name, "endpoint": real, "host": m.group(1) if m else None, "age": 0})
    return out


def client_list(s):
    """-> list of {label, endpoint, host, age} (age None = never, 0 = connected now), or None if unknown."""
    if s["type"] == "wireguard":
        return wg_peers(s["dev"])
    return openvpn_clients(s["status_file"]) if s.get("status_file") else None


def port_listening(proto, port):
    rc, out, _ = run(["ss", "-Hln" + ("u" if proto == "udp" else "t")])
    return any(re.search(rf":{port}\s", l) for l in out.splitlines())


# --------------------------------------------------------------------------- doctor

def doctor(cfg, fix=False, config_path=CONFIG_PATH):
    need_root("doctor")
    problems = 0

    def chk(cond, good, badmsg):
        nonlocal problems
        if cond:
            ok(good)
        else:
            bad(badmsg)
            problems += 1
        return cond

    role, transports = cfg["role"], cfg["transports"]
    head(f"tunnel-fw doctor (role {role})")
    rc, out, _ = run(["systemctl", "is-enabled", "nftables"])
    chk(out.strip() == "enabled", "nftables.service enabled at boot",
        "nftables.service NOT enabled - rules vanish on reboot (run `tunnel-fw apply`)")
    try:
        disk = open(NFT_CONF).read()
    except OSError:
        disk = ""
    chk(strip_header(disk) == strip_header(render(cfg)), f"{NFT_CONF} matches config",
        f"{NFT_CONF} differs from {config_path} - run `tunnel-fw apply`")
    rc, out, _ = run(["nft", "list", "tables"])
    need = {"table inet filter"} | ({"table ip nat"} if role == "fe" and cfg.get("forwards") else set())
    chk(need <= set(l.strip() for l in out.splitlines()), "live ruleset has the expected tables",
        "live ruleset is missing tunnel-fw tables - run `tunnel-fw apply`")
    if wants_forwarding(cfg):
        chk(read_forward() == "1", "net.ipv4.ip_forward = 1", "net.ipv4.ip_forward is 0 - forwarding is off")

    links = [(r, transport_listens(role, r), "Upstream" if role == "fe" else "Transport") for r in transports]
    links += [(d, ingress_listens(d), "Downstream") for d in cfg.get("downstream_tunnels") or []]
    for r, listens, label in links:
        head(f"{label} tunnel {r['name']} ({r['type']} {r['dev']})")
        hint = {"wireguard": f"systemctl status wg-quick@{r['dev']}", "openvpn": "systemctl status openvpn@<name>",
                "ssh": "is the ssh -w session up? pgrep -af 'ssh.*-w'"}[r["type"]]
        if not chk(os.path.exists(f"/sys/class/net/{r['dev']}"), f"interface {r['dev']} exists",
                   f"interface {r['dev']} missing - is its tunnel running? ({hint})"):
            continue
        local, _, _ = iface_v4(r["dev"])
        chk(local == r["local_ip"], f"{r['dev']} has {r['local_ip']}", f"{r['dev']} has {local}, config says {r['local_ip']}")
        if listens:
            chk(port_listening(r["proto"], r["port"]), f"listening on {r['proto']}/{r['port']}",
                f"nothing listening on {r['proto']}/{r['port']}")
        if r["type"] == "wireguard":
            ages = [p["age"] for p in wg_peers(r["dev"]) if p["age"] is not None]
            if ages:
                (ok if min(ages) < 180 else warn)(f"WireGuard handshake {min(ages)}s ago")
            else:
                warn("WireGuard: no handshake yet")
        rc, out, _ = run(["ping", "-c", "2", "-W", "2", "-I", r["dev"], r["peer_ip"]])
        m = re.search(r"= [\d.]+/([\d.]+)/", out)
        chk(rc == 0, f"peer {r['peer_ip']} answers ({m.group(1) if m else '?'} ms)",
            f"peer {r['peer_ip']} does not answer over the transport tunnel")

    if role == "fe":
        r = transports[0]
        head("Forwards")
        rc, natout, _ = run(["nft", "list", "chain", "ip", "nat", "prerouting"])
        ct = ensure_conntrack(False)
        if not ct:
            warn("conntrack tool not installed - can't inspect NAT state (apt install conntrack)")
        for f in cfg.get("forwards", []):
            m = re.search(rf"{f['proto']} dport {f['port']} counter packets (\d+)", natout)
            hits = "no counter" if not m else f"{m.group(1)} pkts DNATed"
            info(f"{spec_str(f)} -> {r['peer_ip']}:{f['to_port']} ({hits})")
            if not ct:
                continue
            rc, out, err = run(["conntrack", "-L", "-p", f["proto"], "--dport", str(f["port"])])
            good_n, stale = 0, []
            for line in out.splitlines():
                srcs = re.findall(r"src=(\S+)", line)
                dsts = re.findall(r"dst=(\S+)", line)
                sps = re.findall(r"sport=(\d+)", line)
                if len(srcs) < 2 or not dsts or dsts[0] == r["peer_ip"]:
                    continue
                if srcs[1] == r["peer_ip"]:
                    good_n += 1
                else:
                    stale.append((srcs[0], sps[0] if sps else None))
            if good_n:
                ok(f"{good_n} client flow(s) correctly NATed into the transport tunnel")
            else:
                info("no active client flows right now")
            if stale:
                bad(f"{len(stale)} STALE flow(s) not NATed (created before the rules loaded): "
                    + ", ".join(f"{s}:{p}" for s, p in stale) + " - these clients can't connect")
                problems += 1
                if fix:
                    for s, p in stale:
                        cmd = ["conntrack", "-D", "-p", f["proto"], "-s", s, "--dport", str(f["port"])]
                        if p:
                            cmd += ["--sport", p]
                        run(cmd)
                    ok("deleted stale flows; clients will reconnect within seconds")
                    problems -= 1
                else:
                    info("fix with: tunnel-fw doctor --fix")
    else:
        via = {x["peer_ip"]: x["name"] for x in transports}
        for s in cfg["client_tunnels"]:
            allowed = {r["name"] for r in ct_via(cfg, s)}
            head(f"Client tunnel {s['name']} ({s['type']} {s['dev']})")
            if chk(os.path.exists(f"/sys/class/net/{s['dev']}"), f"{s['dev']} is up",
                   f"{s['dev']} is down - is the client tunnel service running?"):
                chk(port_listening(s["proto"], s["port"]), f"listening on {s['proto']}/{s['port']}",
                    f"nothing listening on {s['proto']}/{s['port']}")
                clients = client_list(s)
                if s["type"] == "ssh":
                    rc, out, _ = run(["ss", "-Htn", "state", "established", f"( sport = :{s['port']} )"])
                    info(f"SSH client tunnel: {len(out.splitlines())} established connection(s) on tcp/{s['port']} "
                         "(includes ordinary SSH logins if they share the port)")
                elif clients is None:
                    info("can't list OpenVPN clients - set a status file (`status /run/openvpn-<name>.status` in its "
                         "config, then `tunnel-fw setup`)")
                else:
                    active = {x["name"]: 0 for x in transports if x["name"] in allowed}
                    for c in clients:
                        host, age = c["host"], c["age"]
                        route = f"via {via[host]}" if host in via else ("direct" if host else "")
                        desc = f"client {c['label']:<18} {route:<12} endpoint {c['endpoint']:<22}"
                        if age is None:
                            info(desc + " never connected")
                        elif age < 180:
                            ok(desc + (" connected" if age == 0 and s["type"] == "openvpn" else f" handshake {age}s ago"))
                            if host in via:
                                active[via[host]] = active.get(via[host], 0) + 1
                        else:
                            warn(desc + f" last handshake {age // 60} min ago")
                        if s.get("only_via_transport", True) and host and host not in via:
                            warn("  ^ reached the gateway without going through any configured transport tunnel")
                        elif s.get("only_via_transport", True) and host in via and via[host] not in allowed:
                            warn(f"  ^ came in through {via[host]}, which isn't listed for this client tunnel")
                    info("active clients per transport tunnel: " + ", ".join(f"{n}={c}" for n, c in active.items()))

    if role == "gw" and cfg.get("join_nets"):
        head("Joined client subnets")
        chk(read_forward() == "1", "net.ipv4.ip_forward = 1", "net.ipv4.ip_forward is 0 - joined subnets can't reach each other")
        for n in cfg["join_nets"]:
            net = ipaddress.IPv4Network(n)
            host = str(next(net.hosts(), net.network_address))
            rc, out, _ = run(["ip", "-o", "route", "get", host])
            m = re.search(r"\bdev (\S+)", out)
            dev = m.group(1) if m else None
            chk(rc == 0 and dev and dev != cfg["wan_if"], f"{n} is reachable via {dev}",
                f"{n} has no route through a client tunnel (goes via {dev or '?'}) - is that leg's tunnel up?")
    head("Result")
    if problems:
        bad(f"{problems} problem(s) found")
    else:
        ok("all checks passed")
    return problems == 0


# --------------------------------------------------------------------------- multi-FE

def require_gw(cfg, what):
    if cfg["role"] != "gw":
        die(f"{what} runs on the gateway." + (" On a new FE, run `tunnel-fw setup` there and choose role fe."
                                              if what == "add-fe" else ""))


def list_fe(cfg):
    role, transports = cfg["role"], cfg["transports"]
    head(f"Transport tunnels on this {'gateway' if role == 'gw' else 'FE'}")
    active, counted = {}, False
    if role == "gw" and os.geteuid() == 0:
        via = {x["peer_ip"]: x["name"] for x in transports}
        for ct in cfg["client_tunnels"]:
            clients = client_list(ct)
            if clients is None:
                continue
            counted = True
            for c in clients:
                if c["host"] in via and c["age"] is not None and c["age"] < 180:
                    active[via[c["host"]]] = active.get(via[c["host"]], 0) + 1
    for r in transports:
        up = os.path.exists(f"/sys/class/net/{r['dev']}")
        carries = ([c["name"] for c in cfg["client_tunnels"] if r in ct_via(cfg, c)] if role == "gw" else [])
        line = (transport_line(role, r) + (f"  carries {', '.join(carries) or 'no client tunnel'}" if role == "gw" else "")
                + (f"  clients {active.get(r['name'], 0)}" if counted else ""))
        (ok if up else bad)(line + ("" if up else "  (interface down)"))
    for it in cfg.get("downstream_tunnels") or []:
        up = os.path.exists(f"/sys/class/net/{it['dev']}")
        (ok if up else bad)(ingress_line(it) + ("" if up else "  (interface down)"))


def add_fe(cfg, args):
    require_gw(cfg, "add-fe")
    transports = cfg["transports"]
    known = {r["dev"] for r in transports} | {c["dev"] for c in cfg["client_tunnels"]}
    found = [t for t in detect_tunnels() if t.get("running")]
    cand = next((t for t in found if t.get("dev") not in known and not t.get("multi")), None)
    head(f"Add an FE transport tunnel (this gateway has {len(transports)}: {', '.join(r['name'] for r in transports)})")
    if cand:
        info(f"found a tunnel not configured yet (for reference): {tunnel_str(cand)}")
    else:
        warn("no un-configured tunnel found here; set up the new FE's transport tunnel (OpenVPN or WireGuard, with its "
             "own tunnel IPs) first, or enter the values by hand")
    preset = {"name": args.name, "type": args.type, "dev": args.dev, "port": args.port,
              "listener": args.listener, "local_ip": args.local_ip, "peer_ip": args.peer_ip,
              "peer_public_ip": args.fe_ip}
    r = ask_transport("gw", transport_view(cand, "gw") if cand else {}, new_taken(transports), len(transports),
                  prev=transports[-1], preset=preset)
    new = json.loads(json.dumps(cfg))
    # a client tunnel without `via` means "every transport tunnel"; pin it to today's legs so the new FE
    # doesn't silently start carrying it (we ask below instead)
    for c in new["client_tunnels"]:
        if c.get("only_via_transport", True) and not c.get("via"):
            c["via"] = [t["name"] for t in transports]
    new["transports"].append(r)

    ct_preset = {"name": args.client_name, "type": args.client_type, "dev": args.client_dev,
                 "port": args.client_port, "subnet": args.client_subnet}
    explicit = [c for c in new["client_tunnels"] if c.get("only_via_transport", True) and c.get("via")]
    if args.carries is not None:
        want = v_via_names(args.carries, [c["name"] for c in new["client_tunnels"]], "--carries")
        for c in new["client_tunnels"]:
            if c["name"] in want and c.get("via") and r["name"] not in c["via"]:
                c["via"].append(r["name"])
    if any(v is not None for v in ct_preset.values()):
        add_ct = True
    elif args.no_client_tunnel:
        add_ct = False
    else:
        add_ct = ask_yn(f"Add a client tunnel whose clients come in through {r['name']}", True)
    if add_ct:
        head(f"Client tunnel for {r['name']}")
        ct_cand = next((t for t in found if t.get("multi") and t.get("dev") not in known), None)
        if ct_cand:
            info(f"found a client tunnel not configured yet (for reference): {tunnel_str(ct_cand)}")
        new["client_tunnels"].append(ask_client_tunnel(client_tunnel_view(ct_cand) if ct_cand else {},
                                                       new["transports"], new_ct_taken(new), ct_preset, via=[r["name"]]))
    elif args.carries is None and not args.no_client_tunnel:
        for c in explicit:
            if ask_yn(f"Do {c['name']} clients also come in through {r['name']}", False):
                nc = next(x for x in new["client_tunnels"] if x["name"] == c["name"])
                nc["via"].append(r["name"])
    if not any(r in ct_via(new, c) for c in new["client_tunnels"]):
        warn(f"no client tunnel comes in through {r['name']} yet - its clients won't be accepted")
    validate_config(new, "add-fe")
    return new


def v_via_names(a, names, flag):
    got = [x.strip() for x in a.replace(" ", ",").split(",") if x.strip()]
    bad_ = [x for x in got if x not in names]
    if bad_:
        die(f"{flag}: no client tunnel called {', '.join(bad_)} (have: {', '.join(names)})")
    return got


def remove_fe(cfg, which):
    require_gw(cfg, "remove-fe")
    match = [r for r in cfg["transports"] if which in (r["name"], r["dev"])]
    if not match:
        die(f"no transport tunnel called '{which}' (have: {', '.join(r['name'] for r in cfg['transports'])})")
    if len(cfg["transports"]) == 1:
        die("that's the only transport tunnel - clients would have no way in. Use `tunnel-fw setup` to replace it.")
    gone = match[0]
    affected = [c for c in cfg["client_tunnels"] if gone in ct_via(cfg, c)]
    new = json.loads(json.dumps(cfg))
    new["transports"] = [r for r in new["transports"] if r["name"] != gone["name"]]
    dropped = []
    for c in new["client_tunnels"]:
        if c.get("via") and gone["name"] in c["via"]:
            c["via"].remove(gone["name"])
            if not c["via"]:
                dropped.append(c["name"])
    head(f"Remove FE transport tunnel {gone['name']} ({gone['type']} {gone['dev']})")
    if dropped and len(dropped) == len(new["client_tunnels"]):
        die(f"{', '.join(dropped)} only come(s) in through {gone['name']} - removing it would leave no client tunnel. "
            "Use `tunnel-fw setup` to rebuild instead.")
    new["client_tunnels"] = [c for c in new["client_tunnels"] if c["name"] not in dropped]
    if dropped:
        warn(f"client tunnel(s) {', '.join(dropped)} only came in through {gone['name']} and are removed too")
    warn(f"clients currently coming in through {gone['name']} will be cut off")
    return new, {"transport": gone, "client_tunnels": affected, "dropped": dropped}


def join_nets(cfg, args):
    """Gateway: let clients on the listed subnets (typically one per FE leg) reach each other."""
    require_gw(cfg, "join-nets")
    new = json.loads(json.dumps(cfg))
    cur = cfg.get("join_nets") or []
    head("Join client subnets")
    info(f"currently joined: {', '.join(cur) if cur else 'none'}")
    if args.off:
        if not cur:
            die("no client subnets are joined - nothing to turn off")
        new.pop("join_nets", None)
        warn("clients on different subnets will no longer reach each other")
        return new
    if args.nets:
        try:
            nets = v_join_nets(args.nets)
        except ValueError as e:
            die(str(e))
    else:
        mine = [c["subnet"] for c in cfg["client_tunnels"]]
        print("    client subnets whose clients may talk to each other, e.g. one per FE leg,")
        print("    or one network covering them all (172.23.0.0/16)")
        info("client tunnel subnets here: " + ", ".join(f"{c['name']}={c['subnet']}" for c in cfg["client_tunnels"]))
        nets = ask("Client subnets to join", ", ".join(cur or mine), v_join_nets)
    new["join_nets"] = nets
    return new


def ct_line(cfg, c):
    via = ", ".join(r["name"] for r in ct_via(cfg, c)) if c.get("only_via_transport", True) else "anywhere"
    return f"client tunnel {c['name']}: {c['type']} {c['dev']} {c['proto']}/{c['port']} {c['subnet']}  clients via {via}"


def edit_menu(cfg, ssh_ports):
    """Change, add or delete parts of the saved config without editing the JSON.
    Returns (new config, removed transport tunnels) to apply, or None if nothing should be applied."""
    new = json.loads(json.dumps(cfg))
    role = new["role"]
    removed, dirty = [], False

    def blank_add_fe_args():
        return argparse.Namespace(name=None, type=None, dev=None, port=None, listener=None, local_ip=None,
                                  peer_ip=None, fe_ip=None, client_name=None, client_type=None, client_dev=None,
                                  client_port=None, client_subnet=None, no_client_tunnel=False, carries=None)

    def delete(kind, i):
        nonlocal new
        if kind == "ct":
            if len(new["client_tunnels"]) == 1:
                warn("that's the only client tunnel - change it instead of deleting it")
                return False
            c = new["client_tunnels"].pop(i)
            ok(f"deleted client tunnel {c['name']}")
            return True
        if len(new["transports"]) == 1:
            warn("that's the only transport tunnel - change it instead of deleting it")
            return False
        gone = new["transports"][i]
        affected = [c for c in new["client_tunnels"] if gone in ct_via(new, c)]
        trial = json.loads(json.dumps(new))
        trial["transports"].pop(i)
        dropped = []
        for c in trial["client_tunnels"]:
            if c.get("via") and gone["name"] in c["via"]:
                c["via"].remove(gone["name"])
                if not c["via"]:
                    dropped.append(c["name"])
        if dropped and len(dropped) == len(trial["client_tunnels"]):
            warn(f"{', '.join(dropped)} only come(s) in through {gone['name']} - deleting it would leave no client tunnel")
            return False
        if dropped and not ask_yn(f"Client tunnel(s) {', '.join(dropped)} only come in through {gone['name']} and will be "
                                  "deleted too. Continue", False):
            return False
        trial["client_tunnels"] = [c for c in trial["client_tunnels"] if c["name"] not in dropped]
        new = trial
        removed.append({"transport": gone, "client_tunnels": affected, "dropped": dropped})
        ok(f"deleted transport tunnel {gone['name']}" + (f" and client tunnel(s) {', '.join(dropped)}" if dropped else ""))
        return True

    while True:
        items = [("public interface", new["wan_if"], ("wan",))]
        if role == "fe":
            items.append(("", transport_line("fe", new["transports"][0]), ("transport", 0)))
            items.append((f"clients connect directly on {new['wan_if']}", "yes" if new.get("direct_clients", True) else "no",
                          ("direct",)))
            items += [("", ingress_line(d), ("down", i)) for i, d in enumerate(new.get("downstream_tunnels") or [])]
            items.append(("forwards", list_str(new.get("forwards", [])), ("forwards",)))
        else:
            items += [("", transport_line("gw", r), ("transport", i)) for i, r in enumerate(new["transports"])]
            items += [("", ct_line(new, c), ("ct", i)) for i, c in enumerate(new["client_tunnels"])]
            items.append(("joined client subnets", ", ".join(new.get("join_nets") or []) or "none", ("join",)))
        items += [("open ports", list_str(new["services"]), ("services",)),
                  ("outbound", list_str(new["egress"]), ("egress",)),
                  ("policy / logging / DHCP", f"{new['policy']}, logging {'on' if new.get('log', True) else 'off'}, "
                   f"DHCP rules {'yes' if new.get('dhcp') else 'no'}", ("settings",))]
        head(f"Current setup ({'gateway' if role == 'gw' else 'FE'})" + ("  - unsaved changes" if dirty else ""))
        for n, (lab, val, _) in enumerate(items, 1):
            print(f"  {n:>2}) " + (f"{lab}: " if lab else "") + val)
        acts = ["NUMBER = change it"]
        if role == "gw":
            acts += ["a = add an FE leg", "c = add a client tunnel", "d NUMBER = delete a tunnel"]
        else:
            acts += ["a = add a downstream tunnel", "d NUMBER = delete a downstream tunnel"]
        acts += ["s = save and apply", "q = quit"]
        print("    " + "   ".join(acts))
        choice = ask("Choice", None).strip().lower()
        before, n_removed = json.loads(json.dumps(new)), len(removed)
        changed = False
        if choice == "q":
            if dirty and not ask_yn("Discard your unsaved changes", False):
                continue
            return None
        if choice == "s":
            if not dirty:
                info("nothing changed")
                return None
            return new, removed
        if role == "gw" and choice == "a":
            new = add_fe(new, blank_add_fe_args())
            changed = True
        elif role == "gw" and choice == "c":
            head("Add a client tunnel")
            new["client_tunnels"].append(ask_client_tunnel({}, new["transports"], new_ct_taken(new)))
            changed = True
        elif role == "fe" and choice == "a":
            head(f"Add downstream tunnel #{len(new['downstream_tunnels']) + 1}")
            new["downstream_tunnels"].append(
                ask_transport("fe", {}, new_taken(new["transports"] + new["downstream_tunnels"]), 1, link="prev"))
            changed = True
        elif role == "fe" and re.fullmatch(r"d\s*\d+", choice):
            n = int(choice[1:].strip())
            if not 1 <= n <= len(items) or items[n - 1][2][0] != "down":
                warn("only downstream tunnels can be deleted here - pick one of their numbers")
                continue
            if not new.get("direct_clients", True) and len(new["downstream_tunnels"]) == 1:
                warn("that's this FE's only source of clients - turn on direct clients first, or change the tunnel instead")
                continue
            gone = new["downstream_tunnels"].pop(items[n - 1][2][1])
            ok(f"deleted downstream tunnel {gone['name']}")
            changed = True
        elif role == "gw" and re.fullmatch(r"d\s*\d+", choice):
            n = int(choice[1:].strip())
            if not 1 <= n <= len(items) or items[n - 1][2][0] not in ("transport", "ct"):
                warn("only transport tunnels and client tunnels can be deleted - pick one of their numbers")
                continue
            kind, i = items[n - 1][2]
            changed = delete(kind, i)
        elif choice.isdigit() and 1 <= int(choice) <= len(items):
            key = items[int(choice) - 1][2]
            kind = key[0]
            if kind == "wan":
                new["wan_if"] = ask("Public (internet-facing) interface", new["wan_if"], v_iface)
            elif kind == "transport":
                i = key[1]
                old = new["transports"][i]
                head(f"Change {'upstream' if role == 'fe' else 'transport'} tunnel {old['name']} (Enter keeps the value in brackets)")
                others = [r for j, r in enumerate(new["transports"]) if j != i]
                taken = new_taken(others + (new.get("downstream_tunnels") or []))
                taken["dev"] |= {c["dev"] for c in new.get("client_tunnels", [])}
                r = ask_transport(role, {}, taken, i, cur=old)
                new["transports"][i] = r
                if r["name"] != old["name"]:
                    for c in new.get("client_tunnels", []):
                        if c.get("via"):
                            c["via"] = [r["name"] if v == old["name"] else v for v in c["via"]]
            elif kind == "direct":
                new["direct_clients"] = ask_yn(f"Do clients connect directly to this FE (on {new['wan_if']})",
                                               new.get("direct_clients", True))
            elif kind == "down":
                i = key[1]
                old = new["downstream_tunnels"][i]
                head(f"Change downstream tunnel {old['name']} (Enter keeps the value in brackets)")
                others = new["transports"] + [d for j, d in enumerate(new["downstream_tunnels"]) if j != i]
                new["downstream_tunnels"][i] = ask_transport("fe", {}, new_taken(others), 1, cur=old, link="prev")
            elif kind == "forwards":
                res = tunnel_ports(dict(new, forwards=[]))  # all listening tunnel ports, SSH ones included
                new["forwards"] = ask_forwards(res, list_str(new.get("forwards", [])) or None)
            elif kind == "ct":
                i = key[1]
                old = new["client_tunnels"][i]
                head(f"Change client tunnel {old['name']} (Enter keeps the value in brackets)")
                others = dict(new, client_tunnels=[c for j, c in enumerate(new["client_tunnels"]) if j != i])
                new["client_tunnels"][i] = ask_client_tunnel(old, new["transports"], new_ct_taken(others), cur=old)
            elif kind == "join":
                mine = [c["subnet"] for c in new["client_tunnels"]]
                print("    client subnets whose clients may talk to each other; 'none' turns it off")
                ans = ask("Client subnets to join", ", ".join(new.get("join_nets") or mine),
                          lambda a: [] if a.strip().lower() == "none" else v_join_nets(a))
                if ans:
                    new["join_nets"] = ans
                else:
                    new.pop("join_nets", None)
            elif kind == "services":
                new["services"] = ask_services(list_str(new["services"]), tunnel_ports(new, for_services=True), ssh_ports)
            elif kind == "egress":
                new["egress"] = ask("Allowed outbound", list_str(new["egress"]), lambda a: parse_list(a, "egress"))
            elif kind == "settings":
                new["policy"] = ask_choice("Policy for unlisted traffic", ["accept", "drop"], new["policy"])
                new["log"] = ask_yn("Log unlisted traffic", new.get("log", True))
                new["dhcp"] = ask_yn("Does this server get its IP address by DHCP (adds DHCP rules)", bool(new.get("dhcp")))
            changed = new != before
        else:
            warn("pick a number from the list" + (", a, c, d NUMBER," if role == "gw" else ", a, d NUMBER,") + " s or q")
            continue
        if changed:
            problem = validate_config(new, "edit", fatal=False)
            if problem:
                warn(f"not changed: {problem}")
                new = before
                del removed[n_removed:]
            else:
                dirty = True
        elif choice.isdigit():
            info("no change")


def flush_removed_transport(removed, interactive):
    """Established flows from the removed transport tunnel would otherwise stay accepted while clients keep sending."""
    gone = removed["transport"]
    have_ct = ensure_conntrack(interactive)
    for s in removed["client_tunnels"]:
        cmd = ["conntrack", "-D", "-p", s["proto"], "-s", gone["peer_ip"], "--dport", str(s["port"])]
        if not have_ct:
            warn(f"skipped; to cut existing {s['name']} clients now run: {' '.join(cmd)}")
            continue
        rc, out, err = run(cmd)
        m = re.search(r"(\d+) flow entries", out + err)
        ok(f"cleared {m.group(1) if m else 0} {s['name']} conntrack entries from {gone['name']}")
    svc = f"wg-quick@{gone['dev']}" if gone["type"] == "wireguard" else "openvpn@<name>"
    info(f"remember to stop that transport tunnel's tunnel on this host (e.g. systemctl disable --now {svc})")
    for name in removed["dropped"]:
        info(f"and the {name} client tunnel's service, which no longer has a way in")


def dry_run_show(cfg):
    head("Ruleset (dry run - nothing changed)")
    text = render(cfg)
    print(text)
    if os.geteuid() == 0:
        tmp = f"/tmp/tunnel-fw-dryrun-{os.getpid()}.nft"
        write_atomic(tmp, text, 0o600)
        good, err = nft_check(tmp)
        os.remove(tmp)
        if good:
            ok("nft syntax check passed")
        else:
            bad(f"nft rejected it:\n{err}")


# --------------------------------------------------------------------------- main

def build_parser():
    ap = argparse.ArgumentParser(prog="tunnel-fw", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--config", default=CONFIG_PATH, help=f"config file (default {CONFIG_PATH})")
    ap.add_argument("--version", action="version", version=f"tunnel-fw {VERSION}")
    sub = ap.add_subparsers(dest="cmd")
    s = sub.add_parser("setup", help="interactive wizard, then apply (default)")
    s.add_argument("--dry-run", action="store_true", help="ask questions and print the ruleset; change nothing")
    ap_ = sub.add_parser("apply", help="apply the saved config")
    af = sub.add_parser("add-fe", help="(gateway) add another FE transport tunnel")
    af.add_argument("--dry-run", action="store_true", help="show the result; change nothing")
    af.add_argument("--name", help="transport tunnel name, e.g. river2 (comment becomes RIVER2-VPN)")
    af.add_argument("--type", help="transport tunnel type: wireguard, openvpn or ssh")
    af.add_argument("--dev", help="transport tunnel interface on this gateway, e.g. fe2")
    af.add_argument("--port", help="transport tunnel proto/port on the listening side, e.g. udp/43022")
    af.add_argument("--listener", help="does this gateway listen for the transport tunnel or connect out to the FE: listen, connect or both "
                    "(fe/gw/both also accepted)")
    af.add_argument("--local-ip", help="this gateway's transport tunnel IP")
    af.add_argument("--peer-ip", help="the FE's transport tunnel IP")
    af.add_argument("--fe-ip", help="the FE's public IP")
    af.add_argument("--client-name", help="new client tunnel coming in through this FE: name, e.g. salmon2")
    af.add_argument("--client-type", help="new client tunnel: wireguard, openvpn or ssh")
    af.add_argument("--client-dev", help="new client tunnel: interface on this gateway")
    af.add_argument("--client-port", help="new client tunnel: proto/port, e.g. udp/11224")
    af.add_argument("--client-subnet", help="new client tunnel: client subnet, e.g. 172.23.2.0/24")
    af.add_argument("--no-client-tunnel", action="store_true", help="don't add a client tunnel for this FE")
    af.add_argument("--carries", help="existing client tunnels whose clients also come in through this FE (comma-separated)")
    rf = sub.add_parser("remove-fe", help="(gateway) remove an FE transport tunnel")
    rf.add_argument("fe", help="name or interface of the transport tunnel to remove")
    rf.add_argument("--dry-run", action="store_true", help="show the result; change nothing")
    sub.add_parser("list-fe", help="show transport tunnels (and active clients per FE on a gateway)")
    ed = sub.add_parser("edit", help="change, add or delete tunnels, ports and settings from a menu, then apply")
    ed.add_argument("--dry-run", action="store_true", help="show the result; change nothing")
    jn = sub.add_parser("join-nets", help="(gateway) let clients on these client subnets reach each other")
    jn.add_argument("nets", nargs="?", help="comma-separated subnets, e.g. 172.23.1.0/24,172.23.2.0/24 (asked if omitted)")
    jn.add_argument("--off", action="store_true", help="stop joining the subnets (removes the gateway's forward chain)")
    jn.add_argument("--dry-run", action="store_true", help="show the result; change nothing")
    sub.add_parser("render", help="print the ruleset for the saved config")
    d = sub.add_parser("doctor", help="health-check firewall, transport tunnels, forwards and client tunnel")
    d.add_argument("--fix", action="store_true", help="delete stale (un-NATed) conntrack flows")
    for p in (s, ap_, af, rf, jn, ed):
        p.add_argument("--yes", "-y", action="store_true", help="don't ask before applying")
        p.add_argument("--no-rollback", action="store_true", help="skip the confirm-or-rollback guard")
        p.add_argument("--timeout", type=int, default=60, help="seconds to confirm before rollback (default 60)")
    return ap


def main():
    ap = build_parser()
    argv = sys.argv[1:]
    commands = {"setup", "apply", "add-fe", "remove-fe", "list-fe", "render", "doctor", "join-nets", "edit"}
    if not commands & set(argv) and not {"-h", "--help", "--version"} & set(argv):
        # no subcommand: `tunnel-fw [--config X] [setup options]` means setup
        i = 0
        while i < len(argv) and (argv[i] == "--config" or argv[i].startswith("--config=")):
            i += 1 if "=" in argv[i] else 2
        argv = argv[:i] + ["setup"] + argv[i:]
    args = ap.parse_args(argv)
    cmd = args.cmd

    try:
        if cmd == "setup":
            if not args.dry_run:
                need_root("setup (use --dry-run to just preview)")
            existing = load_config(args.config)
            cfg = wizard(existing, detect())
            summarize(cfg)
            if args.dry_run:
                dry_run_show(cfg)
                return
            if not ask_yn("Save this config and continue", True):
                return
            save_config(cfg, args.config)
            ok(f"saved {args.config}")
            apply(cfg, args.yes, args.no_rollback, args.timeout)
            return

        cfg = load_config(args.config)
        if cfg is None:
            die(f"no config at {args.config} - run `tunnel-fw setup` first")
        if cmd == "apply":
            summarize(cfg)
            sys.exit(0 if apply(cfg, args.yes, args.no_rollback, args.timeout) else 1)
        elif cmd == "render":
            print(render(cfg), end="")
        elif cmd == "doctor":
            sys.exit(0 if doctor(cfg, args.fix, args.config) else 1)
        elif cmd == "list-fe":
            list_fe(cfg)
        elif cmd == "edit":
            if not args.dry_run:
                need_root(cmd)
            res = edit_menu(cfg, detect_ssh_ports())
            if res is None:
                info(f"{args.config} left unchanged")
                return
            new, removed = res
            summarize(new)
            if args.dry_run:
                dry_run_show(new)
                return
            if not apply(new, args.yes, args.no_rollback, args.timeout):
                info(f"{args.config} left unchanged")
                sys.exit(1)
            save_config(new, args.config)
            ok(f"saved {args.config}")
            for gone in removed:
                flush_removed_transport(gone, not args.yes)
        elif cmd in ("add-fe", "remove-fe", "join-nets"):
            if not args.dry_run:
                need_root(cmd)
            if cmd == "add-fe":
                new, gone = add_fe(cfg, args), None
            elif cmd == "join-nets":
                new, gone = join_nets(cfg, args), None
            else:
                new, gone = remove_fe(cfg, args.fe)
            summarize(new)
            if args.dry_run:
                dry_run_show(new)
                return
            if not apply(new, args.yes, args.no_rollback, args.timeout):
                info(f"{args.config} left unchanged")
                sys.exit(1)
            save_config(new, args.config)
            ok(f"saved {args.config}")
            if gone:
                flush_removed_transport(gone, not args.yes)
            if cmd == "join-nets" and not new.get("join_nets"):
                info("net.ipv4.ip_forward was left on; to turn it off at boot, comment out "
                     f"net.ipv4.ip_forward=1 in {SYSCTL_CONF}")
    except KeyboardInterrupt:
        print()
        die("interrupted (if rules were already loaded and unconfirmed, the rollback guard will restore them)", 130)


if __name__ == "__main__":
    main()
