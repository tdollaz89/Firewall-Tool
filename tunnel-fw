# --------------------------------------------------------------------------- output

TTY = sys.stdout.isatty()


def color(code, s):
    return f"\033[{code}m{s}\033[0m" if TTY else s


def head(s):
    print("\n" + color("1;36", f"== {s}"))


def info(s):
    print(color("36", "  ::") + " " + s)


def ok(s):
    print(color("32", "  ✓") + " " + s)


def warn(s):
    print(color("33", "  !") + " " + s)


def bad(s):
    print(color("31", "  ✗") + " " + s)


def die(s, code=1):
    sys.stdout.flush()
    print(color("31", "error: ") + s, file=sys.stderr)
    sys.exit(code)


def run(cmd, inp=None):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, input=inp)
    except FileNotFoundError:
        return 127, "", f"{cmd[0]}: command not found"
    return p.returncode, p.stdout, p.stderr


def need_root(what):
    if os.geteuid() != 0:
        die(f"{what} needs root (try: sudo tunnel-fw ...)")


def other_role(role):
    return "gw" if role == "fe" else "fe"


# --------------------------------------------------------------------------- specs
# Port spec syntax, used everywhere a port list is asked for:
#   tcp/22                 single port
#   tcp/8000-8100          range
#   tcp/22@203.0.113.0/24  only from that source
#   udp/51820:11223        (forwards only) public port 51820 -> gateway port 11223
#   tcp/20022=CUSTOM-SSH   (open ports only) label, used as the rule's comment

SPEC_RE = re.compile(
    r"^(tcp|udp)/(\d{1,5})(?:-(\d{1,5}))?(?::(\d{1,5}))?(?:@([^=\s]+))?(?:=([A-Za-z0-9_.-]{1,64}))?$", re.I)
IFACE_RE = re.compile(r"^[A-Za-z0-9_.:-]{1,15}$")
NAME_RE = re.compile(r"^[A-Za-z0-9_.-]{1,32}$")


def _port(v):
    p = int(v)
    if not 1 <= p <= 65535:
        raise ValueError(f"port {p} out of range")
    return p


def parse_spec(text, kind="service"):
    m = SPEC_RE.match(text.strip())
    if not m:
        raise ValueError(f"can't parse '{text}' (expected e.g. tcp/22, udp/11223)")
    proto, p1, p2, to, src, label = m.groups()
    d = {"proto": proto.lower(), "port": _port(p1)}
    if p2:
        if kind == "forward":
            raise ValueError("forwards take a single port, not a range")
        d["port_end"] = _port(p2)
        if d["port_end"] <= d["port"]:
            raise ValueError(f"bad range in '{text}'")
    if to:
        if kind != "forward":
            raise ValueError(f"':' (port remap) only applies to forwards: '{text}'")
        d["to_port"] = _port(to)
    elif kind == "forward":
        d["to_port"] = d["port"]
    if src:
        if kind != "service":
            raise ValueError(f"'@source' only applies to open services: '{text}'")
        d["src"] = str(ipaddress.ip_network(src, strict=False))
    if label:
        if kind != "service":
            raise ValueError(f"'=label' only applies to open services: '{text}'")
        d["comment"] = label
    return d


def parse_list(text, kind="service"):
    text = text.strip()
    if text.lower() in ("", "none", "-"):
        return []
    out = [parse_spec(t, kind) for t in re.split(r"[,\s]+", text) if t]
    seen, uniq = set(), []
    for d in out:
        k = json.dumps(d, sort_keys=True)
        if k not in seen:
            seen.add(k)
            uniq.append(d)
    return uniq


def spec_str(d):
    s = f"{d['proto']}/{d['port']}"
    if d.get("port_end"):
        s += f"-{d['port_end']}"
    if d.get("to_port") and d["to_port"] != d["port"]:
        s += f":{d['to_port']}"
    if d.get("src"):
        s += f"@{d['src']}"
    if d.get("comment"):
        s += f"={d['comment']}"
    return s


def merge_services(lst):
    """One entry per port (same proto/port/range/source); keep the first label seen."""
    out, idx = [], {}
    for d in lst:
        k = (d["proto"], d["port"], d.get("port_end"), d.get("src"))
        if k in idx:
            if d.get("comment") and not out[idx[k]].get("comment"):
                out[idx[k]]["comment"] = d["comment"]
        else:
            idx[k] = len(out)
            out.append(dict(d))
    return out


def list_str(lst):
    return ", ".join(spec_str(d) for d in lst) or "none"


def v_iface(a):
    if not IFACE_RE.match(a):
        raise ValueError(f"'{a}' is not a valid interface name")
    if not os.path.exists(f"/sys/class/net/{a}"):
        warn(f"interface {a} does not exist right now (fine if its tunnel is down)")
    return a


def v_ip4(a):
    return str(ipaddress.IPv4Address(a))


def v_ip4_or_any(a):
    return None if a.lower() in ("any", "none") else v_ip4(a)


def v_net4(a):
    return str(ipaddress.IPv4Network(a, strict=False))


def v_join_nets(a):
    nets = []
    for part in [x.strip() for x in a.replace(" ", ",").split(",") if x.strip()]:
        if "/" not in part:
            raise ValueError(f"{part}: add the mask, e.g. {part}/24")
        try:
            n = v_net4(part)
        except ValueError:
            raise ValueError(f"{part} is not an IPv4 network")
        if n not in nets:
            nets.append(n)
    if not nets:
        raise ValueError("give at least one subnet")
    return nets


def v_name(a):
    if not NAME_RE.match(a):
        raise ValueError("names are 1-32 chars of letters, digits, . _ -")
    return a


def v_type(a):
    a = a.lower()
    a = {"wg": "wireguard", "ovpn": "openvpn"}.get(a, a)
    if a not in TYPES:
        raise ValueError("type is wireguard (wg), openvpn (ovpn) or ssh")
    return a



def v_forwards(a):
    fw = parse_list(a, "forward")
    if not fw:
        raise ValueError("an FE needs at least one port to forward (the client tunnel's port)")
    return fw


def v_tunnel_port(ttype):
    """proto/port for a tunnel; WireGuard is UDP only, SSH is TCP only (a bare number is accepted)."""
    def v(a):
        if a.isdigit():
            a = f"{'tcp' if ttype == 'ssh' else 'udp'}/{a}"
        d = parse_spec(a, kind="egress")
        if d.get("port_end"):
            raise ValueError("a tunnel needs a single port")
        if ttype == "wireguard" and d["proto"] != "udp":
            raise ValueError("WireGuard is UDP only")
        if ttype == "ssh" and d["proto"] != "tcp":
            raise ValueError("SSH is TCP only")
        return d
    return v


# --------------------------------------------------------------------------- prompts

_EOF = False


def ask(q, default=None, validate=None):
    global _EOF
    while True:
        sfx = f" [{default}]" if default not in (None, "") else ""
        if _EOF:
            a = ""
            print(f"  {q}: {default} (auto)")
        else:
            try:
                a = input(f"  {color('1', q)}{sfx}: ").strip()
            except EOFError:
                _EOF = True
                print()
                a = ""
        if not a and default is not None:
            a = str(default)
        if not a and default is None:
            if _EOF:
                die(f"no answer for '{q}' and stdin is closed")
            warn("an answer is required")
            continue
        if validate:
            try:
                return validate(a)
            except ValueError as e:
                warn(str(e))
                if _EOF:
                    die("invalid default with stdin closed")
                continue
        return a


def ask_yn(q, default=True):
    def v(a):
        a = a.lower()
        if a in ("y", "yes"):
            return True
        if a in ("n", "no"):
            return False
        raise ValueError("answer y or n")
    return ask(q, "Y/n" if default else "y/N",
               lambda a: default if a in ("Y/n", "y/N") else v(a))


def ask_choice(q, choices, default):
    def v(a):
        if a not in choices:
            raise ValueError(f"choose one of: {', '.join(choices)}")
        return a
    return ask(f"{q} ({'/'.join(choices)})", default, v)


# --------------------------------------------------------------------------- detection
# Every tunnel found on the host becomes a dict with (when known):
#   type, dev, file, proto, port, local_ip, peer_ip, subnet,
#   listens / connects  - does THIS host accept / initiate the tunnel
#   multi               - many clients (looks like a client-facing "client_tunnel" server)
#   remote_ip           - address this host connects to
#   seen_ip             - address a peer was last seen connecting from
#   status_file         - OpenVPN status file (client list for doctor)

def default_route_iface():
    rc, out, _ = run(["ip", "-j", "route", "show", "default"])
    try:
        return json.loads(out)[0]["dev"]
    except (ValueError, IndexError, KeyError):
        return None


def iface_v4(dev):
    """-> (local, peer_or_None, prefixlen) for the first IPv4 address on dev."""
    rc, out, _ = run(["ip", "-j", "-4", "addr", "show", "dev", dev])
    try:
        for a in json.loads(out)[0].get("addr_info", []):
            return a["local"], a.get("address"), a.get("prefixlen")
    except (ValueError, IndexError, KeyError):
        pass
    return None, None, None


def resolve4(host):
    try:
        return v_ip4(host)
    except ValueError:
        try:
            return socket.gethostbyname(host)
        except (OSError, UnicodeError):
            return None


def parse_endpoint(ep):
    if not ep or ep == "(none)":
        return None, None
    host, _, port = ep.rpartition(":")
    return resolve4(host.strip("[]")), (int(port) if port.isdigit() else None)


def openvpn_peer_from_logs():
    """Last client address seen in OpenVPN logs."""
    last = None
    for f in glob.glob("/etc/openvpn/*.log") + glob.glob("/etc/openvpn/*/*.log") + glob.glob("/var/log/openvpn/*.log"):
        try:
            for m in re.finditer(r"\[AF_INET\](\d+\.\d+\.\d+\.\d+):\d+", open(f, errors="replace").read()):
                last = m.group(1)
        except OSError:
            pass
    return last


def parse_openvpn(path):
    try:
        text = open(path).read()
    except OSError:
        return None
    d = {"type": "openvpn", "file": path, "proto": "udp", "port": 1194, "mode": "server"}
    block = None
    for raw in text.splitlines():
        line = raw.strip()
        if block:
            if line.lower() == f"</{block}>":
                block = None
            continue
        m = re.match(r"^<([a-z0-9-]+)>$", line, re.I)
        if m:
            block = m.group(1).lower()
            continue
        if not line or line[0] in "#;":
            continue
        k, *args = line.split()
        k = k.lower()
        if k == "dev" and args:
            d["dev"] = args[0]
        elif k in ("port", "lport", "rport") and args and args[0].isdigit():
            d["port"] = int(args[0])
        elif k == "proto" and args:
            d["proto"] = "udp" if args[0].lower().startswith("udp") else "tcp"
        elif k == "remote" and args:
            d["mode"] = "client"
            d["remote"] = args[0]
            if len(args) > 1 and args[1].isdigit():
                d["remote_port"] = int(args[1])
            if len(args) > 2:
                d["proto"] = "udp" if args[2].lower().startswith("udp") else "tcp"
        elif k in ("client", "tls-client"):
            d["mode"] = "client"
        elif k == "ifconfig" and len(args) >= 2:
            d["local_ip"], d["peer_ip"] = args[0], args[1]
        elif k == "server" and len(args) >= 2:
            d["multi"] = True
            try:
                d["subnet"] = str(ipaddress.IPv4Network(f"{args[0]}/{args[1]}", strict=False))
            except ValueError:
                pass
        elif k == "status" and args:
            d["status_file"] = args[0] if os.path.isabs(args[0]) else os.path.join(os.path.dirname(path), args[0])
    if "remote_port" in d:
        d["port"] = d["remote_port"]
    if d.get("remote"):
        d["remote_ip"] = resolve4(d["remote"])
    d["listens"] = d["mode"] == "server"
    d["connects"] = d["mode"] == "client"
    if "local_ip" not in d and d.get("dev"):
        local, peer, plen = iface_v4(d["dev"])
        if local:
            d["local_ip"] = local
            if peer and peer != local:
                d["peer_ip"] = peer
    return d


def parse_wireguard(dev):
    d = {"type": "wireguard", "dev": dev, "proto": "udp", "file": f"/etc/wireguard/{dev}.conf"}
    peers, listen, addrs, have_conf = [], None, [], False
    try:
        sect = None
        with open(d["file"]) as fh:
            for raw in fh:
                line = raw.split("#", 1)[0].strip()
                if not line:
                    continue
                if line.startswith("["):
                    sect = line.strip("[] ").lower()
                    if sect == "peer":
                        peers.append({})
                    continue
                k, _, v = line.partition("=")
                k, v = k.strip().lower(), v.strip()
                if sect == "interface":
                    if k == "listenport" and v.isdigit():
                        listen = int(v)
                    elif k == "address":
                        addrs += [x.strip() for x in v.split(",")]
                elif sect == "peer" and peers:
                    if k == "endpoint":
                        peers[-1]["endpoint"] = v
                    elif k == "allowedips":
                        peers[-1]["allowed"] = v
        have_conf = True
    except OSError:
        d["file"] = None
    rc, out, _ = run(["wg", "show", dev, "dump"])
    live = [l.split("\t") for l in out.strip().splitlines()] if rc == 0 and out.strip() else []
    if not have_conf and live:
        if len(live[0]) > 2 and live[0][2].isdigit() and live[0][2] != "0":
            listen = int(live[0][2])
        peers = [{"allowed": p[3]} for p in live[1:] if len(p) > 3]
    seen = [ip for ip in (parse_endpoint(p[2])[0] for p in live[1:] if len(p) > 2) if ip]

    for a in addrs:
        try:
            i = ipaddress.ip_interface(a)
        except ValueError:
            continue
        if i.version == 4:
            d["local_ip"], d["subnet"] = str(i.ip), str(i.network)
            break
    if "local_ip" not in d:
        local, _, plen = iface_v4(dev)
        if local:
            d["local_ip"] = local
            if plen:
                d["subnet"] = str(ipaddress.ip_interface(f"{local}/{plen}").network)

    endpoints = [parse_endpoint(p["endpoint"]) for p in peers if p.get("endpoint")]
    d["peer_count"] = len(peers)
    d["multi"] = len(peers) >= 2
    d["connects"] = bool(endpoints)
    d["listens"] = listen is not None
    if len(peers) == 1:
        for a in (peers[0].get("allowed") or "").split(","):
            try:
                n = ipaddress.ip_network(a.strip(), strict=False)
            except ValueError:
                continue
            if n.version == 4 and n.prefixlen == 32:
                d["peer_ip"] = str(n.network_address)
                break
        if endpoints:
            d["remote_ip"], d["remote_port"] = endpoints[0]
        if seen:
            d["seen_ip"] = seen[0]
    if d["listens"]:
        d["port"] = listen
    elif d.get("remote_port"):
        d["port"] = d["remote_port"]
    return d


def running_openvpn_configs():
    """Real paths of the config files of running OpenVPN processes (None if /proc can't be read)."""
    found = set()
    try:
        pids = [p for p in os.listdir("/proc") if p.isdigit()]
    except OSError:
        return None
    for pid in pids:
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as fh:
                argv = [a.decode(errors="replace") for a in fh.read().split(b"\0") if a]
            cwd = os.readlink(f"/proc/{pid}/cwd")
        except OSError:
            continue
        if not argv or os.path.basename(argv[0]) != "openvpn":
            continue
        base, conf = cwd, None
        for i, a in enumerate(argv[:-1]):
            if a == "--cd":
                base = argv[i + 1]
            elif a == "--config":
                conf = argv[i + 1]
        if conf is None and len(argv) == 2 and not argv[1].startswith("-"):
            conf = argv[1]          # `openvpn file.conf`
        if conf:
            found.add(os.path.realpath(os.path.join(base, conf)))
    return found


def is_wireguard_link(dev):
    rc, js, _ = run(["ip", "-j", "-d", "link", "show", "dev", dev])
    try:
        return json.loads(js)[0].get("linkinfo", {}).get("info_kind") == "wireguard"
    except (ValueError, IndexError):
        return False


def detect_tunnels():
    out = []
    confs = sorted(set(glob.glob("/etc/openvpn/*.conf") + glob.glob("/etc/openvpn/server/*.conf")
                       + glob.glob("/etc/openvpn/client/*.conf")))
    for f in confs:
        o = parse_openvpn(f)
        if o:
            out.append(o)
    names = []
    rc, js, _ = run(["ip", "-j", "-d", "link", "show", "type", "wireguard"])
    try:
        names = [l["ifname"] for l in json.loads(js) if l.get("ifname")]
    except ValueError:
        pass
    for f in sorted(glob.glob("/etc/wireguard/*.conf")):
        n = os.path.basename(f)[:-5]
        if n not in names:
            names.append(n)
    out += [parse_wireguard(n) for n in names]
    # Running = the tunnel itself is up: an OpenVPN process using that config file, or a live WireGuard
    # interface. (An interface with the same name isn't enough - old configs often reuse dev names like tun0.)
    ovpn = running_openvpn_configs()
    for t in out:
        if t["type"] == "wireguard":
            t["running"] = bool(t.get("dev")) and is_wireguard_link(t["dev"])
        elif ovpn is not None:
            t["running"] = os.path.realpath(t["file"]) in ovpn
        else:
            t["running"] = bool(t.get("dev")) and os.path.exists(f"/sys/class/net/{t['dev']}")
    return out


def tunnel_str(t):
    bits = [t["type"], t.get("dev", "?")]
    if t["type"] == "openvpn":
        bits.append(f"({t['mode']}{', multi-client' if t.get('multi') else ''})")
    else:
        role = "/".join(x for x, on in (("listens", t.get("listens")), ("connects", t.get("connects"))) if on)
        bits.append(f"({t.get('peer_count', 0)} peer(s){', ' + role if role else ''})")
    if t.get("port"):
        bits.append(f"{t.get('proto', 'udp')}/{t['port']}")
    if t.get("local_ip"):
        bits.append(f"{t['local_ip']}" + (f" <-> {t['peer_ip']}" if t.get("peer_ip") else ""))
    if t.get("multi") and t.get("subnet"):
        bits.append(f"subnet {t['subnet']}")
    if t.get("remote_ip"):
        bits.append(f"-> {t['remote_ip']}")
    return " ".join(bits)


def transport_view(t, role):
    """Defaults for a transport tunnel question, from a detected tunnel, seen from `role`."""
    d = {k: t[k] for k in ("type", "dev", "proto", "port", "local_ip", "peer_ip") if t.get(k) is not None}
    lis, con = t.get("listens"), t.get("connects")
    if lis or con:
        d["listener"] = "both" if lis and con else role if lis else other_role(role)
    pub = t.get("remote_ip") or t.get("seen_ip")
    if not pub and t["type"] == "openvpn" and lis:
        pub = openvpn_peer_from_logs()
    if pub:
        d["peer_public_ip"] = pub
    return d


def client_tunnel_view(t):
    return {k: t[k] for k in ("type", "dev", "proto", "port", "subnet", "status_file") if t.get(k) is not None}


def detect_listening():
    rc, out, _ = run(["ss", "-Hlntup"])
    res = {}
    for line in out.splitlines():
        cols = line.split()
        if len(cols) < 5 or cols[0] not in ("tcp", "udp"):
            continue
        addr, _, port = cols[4].rpartition(":")
        addr = addr.strip("[]").split("%")[0]
        if addr.startswith("127.") or addr == "::1" or not port.isdigit():
            continue
        m = re.search(r'\(\("([^"]+)"', line)
        res.setdefault((cols[0], int(port)), m.group(1) if m else "?")
    return res


def detect_dhcp():
    """Best guess whether this server gets its IPv4 address by DHCP (the default for the DHCP question)."""
    if glob.glob("/run/systemd/netif/leases/*"):
        return True
    for f in glob.glob("/run/systemd/network/*.network") + glob.glob("/etc/systemd/network/*.network"):
        try:
            if re.search(r"(?mi)^\s*DHCP\s*=\s*(yes|true|ipv4|both)\s*$", open(f).read()):
                return True
        except OSError:
            pass
    try:
        if re.search(r"(?m)^\s*iface\s+\S+\s+inet\s+dhcp", open("/etc/network/interfaces").read()):
            return True
    except OSError:
        pass
    return run(["pgrep", "-x", "dhclient|dhcpcd"])[0] == 0


def detect_ssh_ports():
    ports = set()
    sc = os.environ.get("SSH_CONNECTION", "").split()
    if len(sc) == 4 and sc[3].isdigit():
        ports.add(int(sc[3]))
    rc, out, _ = run(["ss", "-Htnp", "state", "established"])
    for line in out.splitlines():
        if '"sshd' in line:
            cols = line.split()
            if len(cols) >= 3:
                p = cols[2].rpartition(":")[2]
                if p.isdigit():
                    ports.add(int(p))
    return ports


def detect_current_open():
    """Ports accepted (unconditionally) by an existing inet filter input chain."""
    rc, out, _ = run(["nft", "list", "chain", "inet", "filter", "input"])
    found = []
    for line in out.splitlines():
        if "accept" not in line or any(x in line for x in ("iifname", "saddr", "sport")):
            continue
        m = re.search(r"\b(tcp|udp) dport (\d+)(?:-(\d+))?\b", line)
        if m:
            d = {"proto": m.group(1), "port": int(m.group(2))}
            if m.group(3):
                d["port_end"] = int(m.group(3))
            c = re.search(r'comment "([A-Za-z0-9_.-]{1,64})"', line)
            if c:
                d["comment"] = c.group(1)
            found.append(d)
    return found


def detect():
    return {"wan_if": default_route_iface(), "listening": detect_listening(), "dhcp": detect_dhcp(),
            "ssh_ports": detect_ssh_ports(), "current_open": detect_current_open(),
            "tunnels": detect_tunnels()}


# --------------------------------------------------------------------------- config
# {
#   "role": "fe" | "gw", "wan_if": "eth0",
#   "transports": [{"name" (tunnel name, e.g. river), "type", "dev", "proto", "port", "listener": fe|gw|both,
#               "local_ip", "peer_ip", "peer_public_ip"? (gateway only: the FE's public IP)}],  # FE: exactly one
#   "forwards": [{"proto", "port", "to_port"}],                   # FE only
#   "direct_clients": bool,                                      # FE only: clients connect on wan_if
#   "downstream_tunnels": [{same fields as a transport tunnel, "listener": this|prev|both}],
#              # FE only: tunnels from FEs further out (toward the clients); their clients arrive through them
#   "client_tunnels": [{"name" (e.g. salmon), "type", "dev", "proto", "port", "subnet", "status_file"?,
#              "only_via_transport", "via": [transport tunnel names its clients come in through]}],  # GW only
#   "services": [...], "egress": [...], "policy": "accept" | "drop", "log": bool,
#   "dhcp": bool  (add DHCP client rules; only needed if the server gets its address by DHCP)
#   "join_nets": ["172.23.1.0/24", ...]?  (gateway only: client subnets allowed to reach each other)
# }

def transport_listens(role, r):
    return r["listener"] in (role, "both")


def transport_connects(role, r):
    return r["listener"] in (other_role(role), "both")


def load_config(path):
    try:
        with open(path) as f:
            cfg = normalize_config(json.load(f))
    except FileNotFoundError:
        return None
    except (OSError, ValueError) as e:
        die(f"can't read {path}: {e}")
    validate_config(cfg, path)
    return cfg


def normalize_config(cfg):
    """Upgrade older configs. The transport tunnel was called `river`/`rivers` (v1.0-1.2) and
    `backhauls` (v1.3); the client tunnel was `wg` (v1.0/1.1, WireGuard only) and `salmon` (v1.2).
    v1.0 had a single river; v1.0/1.1 rivers were OpenVPN-only with the FE listening."""
    if not isinstance(cfg, dict):
        return cfg
    role = cfg.get("role")
    if "river" in cfg and "rivers" not in cfg:
        cfg["rivers"] = [cfg.pop("river")]
    for old in ("rivers", "backhauls"):
        if old in cfg and "transports" not in cfg:
            cfg["transports"] = cfg.pop(old)
    if "salmon" in cfg and "client_tunnel" not in cfg:
        cfg["client_tunnel"] = cfg.pop("salmon")
    ct = cfg.get("client_tunnel") or cfg.get("wg")
    for old in ("only_via_river", "only_via_backhaul"):
        if isinstance(ct, dict) and old in ct:
            ct.setdefault("only_via_transport", ct.pop(old))
    for i, r in enumerate(cfg.get("transports") or []):
        if not isinstance(r, dict):
            continue
        r.setdefault("name", "gw" if role == "fe" else f"fe{i + 1}")
        r.setdefault("type", "openvpn")
        r.setdefault("listener", "fe")
        pub = r.pop("fe_public_ip", None) or r.pop("client_ip", None)
        if pub and "peer_public_ip" not in r:
            r["peer_public_ip"] = pub
    if "wg" in cfg and "client_tunnel" not in cfg:
        s = cfg.pop("wg")
        s.setdefault("type", "wireguard")
        s.setdefault("proto", "udp")
        cfg["client_tunnel"] = s
    # v1.0-1.7: one `client_tunnel` -> list `client_tunnels` (no `via` = every transport tunnel carries it)
    if isinstance(cfg.get("client_tunnel"), dict) and "client_tunnels" not in cfg:
        cfg["client_tunnels"] = [cfg.pop("client_tunnel")]
    for ct in cfg.get("client_tunnels") or []:
        if isinstance(ct, dict):
            ct.setdefault("name", ct.get("dev", "client"))
            # v1.0-1.5 options removed in 1.6: the gateway no longer forwards or trusts the client interface
            for old in ("trust_clients", "route_clients", "client_to_client"):
                ct.pop(old, None)
    if role == "fe":
        # v1.9: one optional `ingress_tunnel` (and then no direct clients) -> list `downstream_tunnels` + `direct_clients`
        it = cfg.pop("ingress_tunnel", None)
        if isinstance(it, dict) and "downstream_tunnels" not in cfg:
            cfg["downstream_tunnels"] = [it]
            cfg.setdefault("direct_clients", False)
        cfg.setdefault("downstream_tunnels", [])
        cfg.setdefault("direct_clients", True)
        # an FE keeps the other end's public IP only for a tunnel it connects out on (v1.6 dropped it entirely)
        for r in cfg.get("transports") or []:
            if isinstance(r, dict) and r.get("listener") not in ("gw", "both"):
                r.pop("peer_public_ip", None)
    # v1.0-1.4: `log_only` flag + optional outbound chain -> `policy` + always-on outbound chain
    cfg.setdefault("dhcp", True)  # before 1.6 the DHCP rules were always written
    log_only = cfg.pop("log_only", None)
    cfg.setdefault("policy", "accept" if log_only else "drop")
    if not cfg.pop("restrict_egress", True) or "egress" not in cfg:
        cfg.setdefault("egress", parse_list(DEFAULT_EGRESS, "egress"))
    return cfg


def validate_config(cfg, where="config", fatal=True):
    """Check a config; exits on a problem, or with fatal=False returns the problem as a string (None if fine)."""
    try:
        role = cfg["role"]
        assert role in ("fe", "gw"), "role must be fe or gw"
        assert cfg["policy"] in ("accept", "drop"), "policy must be accept or drop"
        assert IFACE_RE.match(cfg["wan_if"]), "bad wan_if"
        if cfg.get("join_nets"):
            assert role == "gw", "join_nets is a gateway setting"
            v_join_nets(",".join(cfg["join_nets"]))
        transports = cfg["transports"]
        assert isinstance(transports, list) and transports, "need at least one transport tunnel"
        downs = cfg.get("downstream_tunnels") or []
        if role == "fe":
            assert len(transports) == 1, "an FE has exactly one upstream tunnel (toward its gateway)"
            assert cfg.get("direct_clients", True) or downs, \
                "this FE would get no clients - clients must connect directly, or through at least one downstream tunnel"
        else:
            assert not downs, "downstream_tunnels is an FE setting"
        what = "upstream tunnel" if role == "fe" else "transport tunnel"
        for it in downs:
            check_tunnel(it, "downstream tunnel")
            if it.get("peer_public_ip"):
                v_ip4(it["peer_public_ip"])
            assert it["listener"] in ("this", "prev", "both"), f"downstream tunnel {it['name']}: listener must be this, prev or both"
        for r in transports:
            n = r["name"]
            check_tunnel(r, what)
            assert r["listener"] in LISTENERS, f"{what} {n}: listener must be fe, gw or both"
            if r.get("peer_public_ip"):
                v_ip4(r["peer_public_ip"])
            elif role == "gw" and transport_connects(role, r):
                raise AssertionError(f"transport tunnel {n}: this {role} connects out to the {other_role(role)}, "
                                     "so peer_public_ip (its public IP) is required")
        for key in ("name", "dev", "local_ip", "peer_ip"):
            vals = [r[key] for r in transports + downs]
            dup = sorted({v for v in vals if vals.count(v) > 1})
            if role == "fe":
                assert not dup, f"two tunnels on this FE share a {key} ({', '.join(dup)})"
            assert not dup, (f"transport tunnel {key} must be unique per FE (duplicated: {', '.join(dup)}) - "
                             "each FE's transport tunnel needs its own tunnel addresses or replies go out the wrong transport tunnel")
        listen_ports = [(r["proto"], r["port"]) for r in transports if transport_listens(role, r)]
        listen_ports += [(d["proto"], d["port"]) for d in downs if ingress_listens(d)]
        dup = {p for p in listen_ports if listen_ports.count(p) > 1}
        assert not dup, f"two tunnels listen on the same port: {', '.join(f'{a}/{b}' for a, b in dup)}"
        if role == "gw":
            cts = cfg["client_tunnels"]
            assert isinstance(cts, list) and cts, "need at least one client tunnel"
            tnames = [r["name"] for r in transports]
            for s in cts:
                n = s.get("name")
                assert NAME_RE.match(n or ""), f"bad client tunnel name {n!r}"
                assert s["type"] in TYPES, f"client tunnel {n}: type must be wireguard, openvpn or ssh"
                assert IFACE_RE.match(s["dev"]), f"client tunnel {n}: bad dev {s['dev']!r}"
                assert s["proto"] in ("tcp", "udp"), f"client tunnel {n}: proto must be tcp/udp"
                assert s["type"] != "wireguard" or s["proto"] == "udp", f"client tunnel {n}: WireGuard is UDP only"
                assert s["type"] != "ssh" or s["proto"] == "tcp", f"client tunnel {n}: SSH is TCP only"
                _port(s["port"])
                v_net4(s["subnet"])
                assert s["dev"] not in [r["dev"] for r in transports], f"client tunnel {n} and a transport tunnel share an interface"
                assert (s["proto"], s["port"]) not in listen_ports, f"client tunnel {n} and a transport tunnel listen on the same port"
                if "via" in s:
                    assert isinstance(s["via"], list) and s["via"], f"client tunnel {n}: via needs at least one transport tunnel"
                    bad_via = [v for v in s["via"] if v not in tnames]
                    assert not bad_via, f"client tunnel {n}: via {', '.join(bad_via)} - no such transport tunnel"
            for key in ("name", "dev"):
                vals = [c[key] for c in cts]
                dup = sorted({v for v in vals if vals.count(v) > 1})
                assert not dup, f"client tunnel {key} must be unique (duplicated: {', '.join(dup)})"
            cports = [(c["proto"], c["port"]) for c in cts]
            dup = {p for p in cports if cports.count(p) > 1}
            assert not dup, f"two client tunnels listen on the same port: {', '.join(f'{a}/{b}' for a, b in dup)}"
            nets = [(c["name"], ipaddress.IPv4Network(c["subnet"], strict=False)) for c in cts]
            for i, (an, a_) in enumerate(nets):
                for bn, b_ in nets[i + 1:]:
                    assert not a_.overlaps(b_), f"client tunnels {an} and {bn} have overlapping subnets ({a_}, {b_})"
        else:
            clash = [f for f in cfg.get("forwards", []) if (f["proto"], f["port"]) in listen_ports]
            assert not clash, f"forward {list_str(clash)} collides with a tunnel's listening port"
        for key, kind in (("services", "service"), ("forwards", "forward"), ("egress", "egress")):
            for s in cfg.get(key, []):
                parse_spec(spec_str(s), kind)
    except (KeyError, AssertionError, ValueError, TypeError) as e:
        if not fatal:
            return f"{e}"
        die(f"{where}: invalid config ({e.__class__.__name__}: {e})")
    return None


def check_tunnel(r, what):
    n = r["name"]
    assert NAME_RE.match(n), f"bad {what} name {n!r}"
    assert r["type"] in TYPES, f"{what} {n}: type must be wireguard, openvpn or ssh"
    assert IFACE_RE.match(r["dev"]), f"{what} {n}: bad dev {r['dev']!r}"
    assert r["proto"] in ("tcp", "udp"), f"{what} {n}: proto must be tcp/udp"
    assert r["type"] != "wireguard" or r["proto"] == "udp", f"{what} {n}: WireGuard is UDP only"
    assert r["type"] != "ssh" or r["proto"] == "tcp", f"{what} {n}: SSH is TCP only"
    _port(r["port"])
    v_ip4(r["local_ip"])
    v_ip4(r["peer_ip"])
    assert r["local_ip"] != r["peer_ip"], f"{what} {n}: local and peer IP are the same"


def save_config(cfg, path):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    cfg = dict(cfg, version=VERSION)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(cfg, f, indent=2)
        f.write("\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


# --------------------------------------------------------------------------- render

def q(s):
    return '"' + s + '"'


def label(text):
    return f"comment {q(text)}" if text else None


def vpn_label(name):
    """Tunnel name -> rule comment: river -> RIVER-VPN."""
    return label(re.sub(r"(?i)-vpn$", "", name).upper() + "-VPN")


def ports(d):
    return f"{d['port']}-{d['port_end']}" if d.get("port_end") else str(d["port"])


def ct_via(cfg, ct):
    """Transport tunnels a client tunnel's clients come in through (every one if `via` isn't set)."""
    names = ct.get("via")
    return [r for r in cfg["transports"] if not names or r["name"] in names]


def ifset(transports):
    devs = [q(r["dev"]) for r in transports]
    return devs[0] if len(devs) == 1 else "{ " + ", ".join(devs) + " }"


def rule(*parts):
    return "\t\t" + " ".join(p for p in parts if p)


def wants_forwarding(cfg):
    return cfg["role"] == "fe" or bool(cfg.get("join_nets"))


def render(cfg):
    """Ruleset in the house style: flush ruleset; inet filter with input, output, forward;
    `counter` on accepts; `<NAME>-VPN` comments; final log rule. An FE gets a forward chain for its
    port forwards; a gateway gets one only when join_nets is set (clients on those subnets reach each other)."""
    role, wan, transports = cfg["role"], cfg["wan_if"], cfg["transports"]
    r = transports[0]
    downs = (cfg.get("downstream_tunnels") or []) if role == "fe" else []
    # where clients arrive: the public interface (direct clients) and/or the downstream tunnels from other FEs
    ing_devs = ([wan] if cfg.get("direct_clients", True) else []) + [d["dev"] for d in downs]
    ing = q(ing_devs[0]) if len(ing_devs) == 1 else "{ " + ", ".join(q(x) for x in ing_devs) + " }"
    pol = cfg["policy"]
    log = cfg.get("log", True)
    L = []
    a = L.append

    def chain(name):
        a(f"\tchain {name} {{")
        a(f"\t\ttype filter hook {name} priority filter; policy {pol};")

    def log_rule(name):
        if log:
            a(rule(f"log prefix {q(f'nftables {name} dropped: ')}"))
        a("\t}")

    a("flush ruleset")
    a("")
    a("table inet filter {")

    # ---- input
    chain("input")
    a("\t\tct state established,related accept")
    a("\t\tct state invalid drop")
    a('\t\tiif "lo" accept')
    a("\t\tip protocol icmp accept")
    for sv in cfg.get("services", []):
        src = None
        if sv.get("src"):
            net = ipaddress.ip_network(sv["src"])
            src = f"{'ip' if net.version == 4 else 'ip6'} saddr {net}"
        a(rule(src, f"{sv['proto']} dport {ports(sv)} counter accept", label(sv.get("comment"))))
    if cfg.get("dhcp"):
        a(rule("udp sport 67 udp dport 68 counter accept"))
    for x in transports:
        if transport_listens(role, x):
            src = f"ip saddr {x['peer_public_ip']}" if x.get("peer_public_ip") else None
            a(rule(src, f"{x['proto']} dport {x['port']} counter accept", vpn_label(x["name"])))
    for d in downs:
        if ingress_listens(d):
            a(rule(f"{d['proto']} dport {d['port']} counter accept", vpn_label(d["name"])))
    if role == "gw":
        for ct in cfg["client_tunnels"]:
            via = f"iifname {ifset(ct_via(cfg, ct))}" if ct.get("only_via_transport", True) else None
            a(rule(via, f"{ct['proto']} dport {ct['port']} counter accept", vpn_label(ct["name"])))
    log_rule("input")
    a("")

    # ---- output
    chain("output")
    a("\t\tct state established,related accept")
    a("\t\tct state invalid drop")
    a('\t\toif "lo" accept')
    a("\t\tip protocol icmp accept")
    if cfg.get("dhcp"):
        a(rule("udp sport 68 udp dport 67 counter accept"))
    for proto in ("udp", "tcp"):
        items = [ports(e) for e in cfg.get("egress", []) if e["proto"] == proto]
        if items:
            a(rule(f"{proto} dport {items[0] if len(items) == 1 else '{ ' + ', '.join(items) + ' }'} counter accept"))
    for x in transports:
        if transport_connects(role, x):
            dst = f"ip daddr {x['peer_public_ip']}" if x.get("peer_public_ip") else None
            a(rule(dst, f"{x['proto']} dport {x['port']} counter accept", vpn_label(x["name"])))
    for d in downs:
        if ingress_connects(d):
            dst = f"ip daddr {d['peer_public_ip']}" if d.get("peer_public_ip") else None
            a(rule(dst, f"{d['proto']} dport {d['port']} counter accept", vpn_label(d["name"])))
    log_rule("output")

    # ---- forward (FE: port forwards; gateway: only to join client subnets)
    if role == "fe" or cfg.get("join_nets"):
        a("")
        chain("forward")
        a("\t\tct state established,related accept")
        a("\t\tct state invalid drop")
        if role == "fe":
            for f in cfg.get("forwards", []):
                a(rule(f"{f['proto']} dport {f['to_port']} iifname {ing} oifname {q(r['dev'])} counter accept"))
        else:
            nets = cfg["join_nets"]
            ns = nets[0] if len(nets) == 1 else "{ " + ", ".join(nets) + " }"
            a("\t\tip protocol icmp accept")
            a(rule(f"ip saddr {ns} ip daddr {ns} counter accept"))
        log_rule("forward")
    a("}")

    # ---- nat
    if role == "fe" and cfg.get("forwards"):
        a("table ip nat {")
        a("\tchain prerouting {")
        a("\t\ttype nat hook prerouting priority dstnat; policy accept;")
        for f in cfg["forwards"]:
            to = r["peer_ip"] + (f":{f['to_port']}" if f["to_port"] != f["port"] else "")
            a(rule(f"iifname {ing} {f['proto']} dport {f['port']} counter dnat to {to}"))
        a("\t}")
        a("")
        a("\tchain postrouting {")
        a("\t\ttype nat hook postrouting priority srcnat; policy accept;")
        for f in cfg["forwards"]:
            a(rule(f"oifname {q(r['dev'])} {f['proto']} dport {f['to_port']} counter snat to {r['local_ip']}"))
        a("\t}")
        a("}")
    a("")
    return "\n".join(L)

def strip_header(text):
    return "\n".join(l for l in text.splitlines() if not l.startswith("# Generated by tunnel-fw"))


# --------------------------------------------------------------------------- wizard

FLAG_NAMES = {"peer_public_ip": "fe-ip"}


def new_taken(transports=()):
    t = {"name": set(), "dev": set(), "local_ip": set(), "peer_ip": set()}
    for r in transports:
        for k in t:
            t[k].add(r[k])
    return t


# "Does this server listen or connect out?" -> the stored listener value, per kind of tunnel.
# Stored values are unchanged from older versions (fe/gw/both, this/prev/both), and those words are still accepted.
LISTEN_MAP = {
    "upstream": {"listen": "fe", "connect": "gw", "both": "both", "fe": "fe", "gw": "gw", "this": "fe", "next": "gw"},
    "downstream": {"listen": "this", "connect": "prev", "both": "both", "this": "this", "prev": "prev"},
    "gw": {"listen": "gw", "connect": "fe", "both": "both", "gw": "gw", "fe": "fe"},
}


def listen_kind(role, link):
    return "downstream" if link else "upstream" if role == "fe" else "gw"


def listen_word(kind, stored):
    return next(w for w in ("listen", "connect", "both") if LISTEN_MAP[kind][w] == stored)


def v_listen(kind):
    def v(a):
        a = a.strip().lower()
        if a not in LISTEN_MAP[kind]:
            raise ValueError("answer listen, connect or both")
        return LISTEN_MAP[kind][a]
    return v



def ingress_listens(it):
    return it["listener"] in ("this", "both")


def ingress_connects(it):
    return it["listener"] in ("prev", "both")


def ask_transport(role, d, taken, idx, prev=None, preset=None, cur=None, link=None):
    """Ask for one transport tunnel. d = defaults (existing transport tunnel or detected tunnel); taken = values other
    transport tunnels already use; preset = values given as command-line flags (not prompted); cur = the tunnel being
    edited (its values become the defaults); link="prev" = a middle FE's tunnel from the previous FE in the chain."""
    preset, prev, cur = preset or {}, prev or {}, cur or {}
    gw, other = role == "gw" and not link, other_role(role)
    kind = listen_kind(role, link)
    tname = {"upstream": "Upstream tunnel", "downstream": "Downstream tunnel", "gw": "Transport tunnel"}[kind]
    peer_label = {"upstream": "upstream end's tunnel IP (the gateway or the next FE)",
                  "downstream": "downstream end's tunnel IP (the FE further out)",
                  "gw": "FE's transport tunnel IP"}[kind]

    def dv(key):
        if not cur:
            return None
        if key == "port":
            return f"{cur['proto']}/{cur['port']}"
        if key == "listener":
            return listen_word(kind, cur["listener"])
        if key == "peer_public_ip":
            if role == "fe":
                return cur.get(key) or "any"
            return cur.get(key) or ("any" if gw and not transport_connects(role, cur) else None)
        return cur.get(key)

    def uniq(key, validate, also=None):
        def v(a):
            val = validate(a)
            if val in taken[key]:
                raise ValueError(f"{val} is already used by another transport tunnel - each FE needs its own {key}")
            if also and val == also():
                raise ValueError("local and peer IP can't be the same")
            return val
        return v

    def get(key, prompt, default, validate):
        if preset.get(key) is not None:
            try:
                val = validate(str(preset[key]))
            except ValueError as e:
                die(f"--{FLAG_NAMES.get(key, key.replace('_', '-'))}: {e}")
            print(f"  {prompt}: {preset[key]} (from flag)")
            return val
        return ask(prompt, default, validate)

    # No suggested defaults for a new tunnel: these must be typed (running tunnels are listed at the top of setup).
    # When editing, the current values are the defaults.
    name = get("name", f"{tname} name", dv("name"), uniq("name", v_name))
    rtype = get("type", f"{tname} type (wireguard/openvpn/ssh)", dv("type"), v_type)
    dev = get("dev", f"{tname} interface on this host", dv("dev"), uniq("dev", v_iface))
    spec = get("port", "Port", dv("port"), v_tunnel_port(rtype))
    listener = get("listener", "Does this server listen for it, or connect out to the other end (listen/connect/both)",
                   dv("listener"), v_listen(kind))
    local_ip = get("local_ip", "This end's tunnel IP", dv("local_ip"), uniq("local_ip", v_ip4))
    peer_ip = get("peer_ip", f"The {peer_label}", dv("peer_ip"),
                  uniq("peer_ip", v_ip4, lambda: local_ip))
    r = {"name": name, "type": rtype, "dev": dev, "proto": spec["proto"], "port": spec["port"],
         "listener": listener, "local_ip": local_ip, "peer_ip": peer_ip}
    pub = None  # only the gateway asks for the other end's (the FE's) public IP
    if gw and listener in (other, "both"):
        pub = get("peer_public_ip", f"The {other.upper()}'s public IP (this side connects to it)",
                  dv("peer_public_ip"), v_ip4)
    elif gw:
        pub = get("peer_public_ip", f"The {other.upper()}'s public IP, to accept the transport tunnel only "
                  "from it ('any' = anyone)", dv("peer_public_ip"), v_ip4_or_any)
    elif listener in (("prev", "both") if link else ("gw", "both")):
        # an FE that connects out: the other end (gateway or another FE) is the server it dials
        end = "downstream" if link else "upstream"
        pub = get("peer_public_ip", f"The {end} end's public IP (this side connects to it; 'any' = don't restrict)",
                  dv("peer_public_ip"), v_ip4_or_any)
    if pub:
        r["peer_public_ip"] = pub
    for k in taken:
        taken[k].add(r[k])
    return r


def new_ct_taken(cfg_like):
    """Names/interfaces/ports/subnets already used on this gateway, so a new client tunnel can't clash."""
    t = {"name": set(), "dev": set(), "port": set(), "subnet": []}
    for r in cfg_like.get("transports", []):
        t["dev"].add(r["dev"])
        if transport_listens("gw", r):
            t["port"].add((r["proto"], r["port"]))
    for c in cfg_like.get("client_tunnels", []):
        t["name"].add(c["name"])
        t["dev"].add(c["dev"])
        t["port"].add((c["proto"], c["port"]))
        t["subnet"].append(c["subnet"])
    return t


def v_via(transports):
    names = [r["name"] for r in transports]

    def v(a):
        if a.strip().lower() == "all":
            return list(names)
        got = []
        for x in [x.strip() for x in a.replace(" ", ",").split(",") if x.strip()]:
            if x not in names:
                raise ValueError(f"{x}: no such transport tunnel (have: {', '.join(names)})")
            if x not in got:
                got.append(x)
        if not got:
            raise ValueError("name at least one transport tunnel")
        return got
    return v


def ask_client_tunnel(d, transports, taken, preset=None, via=None, cur=None):
    """Ask for one client tunnel. d = defaults for the non-detail questions; taken = see new_ct_taken;
    preset = values from command-line flags; via = fixed list of transport tunnel names (not asked)."""
    preset, cur = preset or {}, cur or {}

    def dv(key):
        if not cur:
            return None
        if key == "port":
            return f"{cur['proto']}/{cur['port']}"
        if key == "via":
            return ", ".join(cur["via"]) if cur.get("via") else ("all" if cur else None)
        return cur.get(key)

    def uniq(key, validate):
        def v(a):
            val = validate(a)
            if key == "port":
                if (val["proto"], val["port"]) in taken["port"]:
                    raise ValueError(f"{val['proto']}/{val['port']} is already used by another tunnel on this gateway")
            elif key == "subnet":
                net = ipaddress.IPv4Network(val)
                for o in taken["subnet"]:
                    if net.overlaps(ipaddress.IPv4Network(o)):
                        raise ValueError(f"overlaps {o}, which another client tunnel uses")
            elif val in taken[key]:
                raise ValueError(f"{val} is already used by another tunnel on this gateway")
            return val
        return v

    def get(key, prompt, validate):
        if preset.get(key) is not None:
            try:
                val = validate(str(preset[key]))
            except ValueError as e:
                die(f"--client-{key}: {e}")
            print(f"  {prompt}: {preset[key]} (from flag)")
            return val
        return ask(prompt, dv(key), validate)

    cname = get("name", "Client tunnel name", uniq("name", v_name))
    stype = get("type", "Client tunnel type (wireguard/openvpn/ssh)", v_type)
    dev = get("dev", "Client tunnel interface", uniq("dev", v_iface))
    spec = get("port", "Client tunnel protocol/port", uniq("port", v_tunnel_port(stype)))
    subnet = get("subnet", "Client subnet", uniq("subnet", v_net4))
    s = {"name": cname, "type": stype, "dev": dev, "proto": spec["proto"], "port": spec["port"], "subnet": subnet}
    if stype == "openvpn":
        st = ask("OpenVPN status file, so doctor can list clients ('none' to skip)",
                 d.get("status_file") or "none")
        if st.lower() != "none":
            s["status_file"] = st
    s["only_via_transport"] = ask_yn("Accept clients ONLY through the transport tunnel(s) (hides gateway from direct access)",
                                     d.get("only_via_transport", True))
    if via is not None:
        s["via"] = via
    elif len(transports) == 1:
        s["via"] = [transports[0]["name"]]
    else:
        s["via"] = ask(f"Transport tunnel(s) its clients come in through ({', '.join(r['name'] for r in transports)}; "
                       "comma-separated, or 'all')", dv("via"), v_via(transports))
    taken["name"].add(s["name"])
    taken["dev"].add(s["dev"])
    taken["port"].add((s["proto"], s["port"]))
    taken["subnet"].append(s["subnet"])
    return s


def ask_services(sdef, reserved, ssh_ports):
    """The open-ports question, with the tunnel-port clash check and the SSH lockout guard."""
    while True:
        services = merge_services(ask("Open ports", sdef, parse_list))
        clash = [x for x in services if (x["proto"], x["port"]) in reserved]
        if not clash:
            break
        warn(f"{list_str(clash)} already handled by the tunnel rules - remove them")
        if _EOF:
            die("conflicting services with stdin closed")
    for sp in sorted(ssh_ports):
        covered = any(x["proto"] == "tcp" and not x.get("src") and x["port"] <= sp <= x.get("port_end", x["port"])
                      for x in services)
        if not covered:
            warn(f"your current SSH session uses tcp/{sp}, which is not in that list - you would be locked out")
            if ask_yn(f"Add tcp/{sp}", True):
                services.append({"proto": "tcp", "port": sp})
    for x in services:     # unlabelled SSH ports get the usual labels
        if x["proto"] == "tcp" and not x.get("port_end") and not x.get("comment"):
            if x["port"] == 22:
                x["comment"] = "SSH"
            elif x["port"] in ssh_ports:
                x["comment"] = "CUSTOM-SSH-PORT"
    return services


def tunnel_ports(cfg, for_services=False):
    """(proto, port) pairs the tunnel rules already handle - not allowed as open ports or forwards.
    for_services: leave out SSH tunnels, whose port may also be the server's own SSH port (tcp/22)."""
    role, res = cfg["role"], set()
    skip = (lambda t: for_services and t["type"] == "ssh")
    for r in cfg["transports"]:
        if transport_listens(role, r) and not skip(r):
            res.add((r["proto"], r["port"]))
    for d in cfg.get("downstream_tunnels") or []:
        if ingress_listens(d) and not skip(d):
            res.add((d["proto"], d["port"]))
    res |= {(f["proto"], f["port"]) for f in cfg.get("forwards", [])}
    res |= {(c["proto"], c["port"]) for c in cfg.get("client_tunnels", []) if not skip(c)}
    return res


def ask_forwards(reserved, default=None):
    while True:
        fw = ask("Ports to forward", default, v_forwards)
        clash = [f for f in fw if (f["proto"], f["port"]) in reserved]
        if not clash:
            return fw
        warn(f"{list_str(clash)} is a transport tunnel's own listening port")
        if _EOF:
            die("conflicting forwards with stdin closed")


def wizard(existing, det):
    e = existing or {}
    tunnels = det["tunnels"]

    head("Detected on this host")
    info(f"default-route interface: {det['wan_if'] or '?'}")
    stopped = [t for t in tunnels if not t.get("running")]
    tunnels = [t for t in tunnels if t.get("running")]
    for t in tunnels:
        info("tunnel: " + tunnel_str(t))
    if not tunnels:
        info("tunnels: none running - you'll enter details by hand")
    if stopped:
        info("not running (config file only, ignored): " + ", ".join(sorted({t.get("dev") or "?" for t in stopped})))
    if det["listening"]:
        info("listening: " + ", ".join(f"{p}/{n} ({proc})" for (p, n), proc in sorted(det["listening"].items())))
    if det["current_open"]:
        info("currently allowed by nftables: " + list_str(det["current_open"]))
    if existing:
        info("existing config found - its values are the defaults below")

    head("Role")
    print("    FE (Ingress): Receives client connections and forwards their VPN traffic through the transport tunnel.")
    print("    GW (Gateway): Terminates transport tunnels and hosts the client VPN endpoint.")
    role_default = e.get("role") or ("gw" if len(tunnels) >= 2 or any(t.get("multi") for t in tunnels) else "fe")
    role = ask_choice("Role of this server", ["fe", "gw"], role_default)

    head("Interfaces")
    wan = ask("Public (internet-facing) interface", None, v_iface)
    dhcp_default = e["dhcp"] if "dhcp" in e else det.get("dhcp", False)
    print(f"    DHCP {'detected' if det.get('dhcp') else 'not detected'} on this server (static addresses need no DHCP rules)")
    dhcp = ask_yn("Does this server get its IP address by DHCP (adds DHCP rules)", dhcp_default)

    cfg = {"role": role, "wan_if": wan, "dhcp": dhcp}
    reserved = set()
    taken = new_taken()

    if role == "fe":
        efe = e if e.get("role") == "fe" else {}
        print("    upstream tunnel = toward the gateway, downstream tunnel = from another FE further out (toward the clients)")
        head("Upstream tunnel")
        er = e["transports"][0] if efe else {}
        guess = next((t for t in tunnels if not t.get("multi")), tunnels[0] if tunnels else None)
        d = {**(transport_view(guess, "fe") if guess else {}), **er}
        transport = ask_transport("fe", d, taken, 0)
        cfg["transports"] = [transport]
        head("Clients")
        while True:
            direct = ask_yn(f"Do clients connect directly to this FE (on {wan})", efe.get("direct_clients", True))
            more = ask_yn("Do other FEs connect to this one through downstream tunnels",
                          bool(efe.get("downstream_tunnels")) or not direct)
            if direct or more:
                break
            warn("this FE needs clients from somewhere - answer yes to at least one")
        cfg["direct_clients"] = direct
        cfg["downstream_tunnels"] = []
        while more:
            head(f"Downstream tunnel #{len(cfg['downstream_tunnels']) + 1}")
            cfg["downstream_tunnels"].append(ask_transport("fe", {}, taken, 1, link="prev"))
            more = ask_yn("Add another downstream tunnel", False)
        reserved |= tunnel_ports(cfg)
        head("Forwards (client tunnel port forward to gateway)")
        print("    the clients' tunnel port(s), e.g. udp/11223 (WireGuard) or tcp/1194 (OpenVPN)")
        print("    format: proto/port, or udp/51820:11223 to remap; comma-separated")
        fw = ask_forwards(reserved)
        cfg["forwards"] = fw
        reserved |= {(f["proto"], f["port"]) for f in fw}
    else:
        ects = (e.get("client_tunnels") or []) if e.get("role") == "gw" else []
        ct_devs = {c["dev"] for c in ects} | {t.get("dev") for t in tunnels if t.get("multi")}

        head("Transport tunnels")
        ers = (e.get("transports") or []) if e.get("role") == "gw" else []
        known = {x["dev"] for x in ers} | ct_devs
        cands = list(ers) + [transport_view(t, "gw") for t in tunnels if t.get("dev") not in known]
        if cands:
            info(f"{len(cands)} candidate transport tunnel(s): " + ", ".join(x.get("name") or x.get("dev", "?") for x in cands))
        transports = []
        while True:
            i = len(transports)
            print(color("1", f"\n  -- FE #{i + 1}"))
            transports.append(ask_transport("gw", cands[i] if i < len(cands) else {}, taken, i,
                                    prev=transports[-1] if transports else None))
            if not ask_yn("Add another FE", len(transports) < len(cands)):
                break
        cfg["transports"] = transports
        reserved |= {(x["proto"], x["port"]) for x in transports if transport_listens("gw", x)}

        head("Client tunnels")
        ct_cands = list(ects) + [client_tunnel_view(t) for t in tunnels
                                 if t.get("multi") and t.get("dev") not in {c["dev"] for c in ects}]
        ctaken = new_ct_taken({"transports": transports})
        cts = []
        while True:
            i = len(cts)
            print(color("1", f"\n  -- client tunnel #{i + 1}"))
            cts.append(ask_client_tunnel(ct_cands[i] if i < len(ct_cands) else {}, transports, ctaken))
            if not ask_yn("Add another client tunnel", len(cts) < max(len(ct_cands), 1)):
                break
        cfg["client_tunnels"] = cts
        reserved |= {(c["proto"], c["port"]) for c in cts}

    reserved = tunnel_ports(cfg, for_services=True)
    head("Services to keep open on this server")
    print("    format: tcp/22, tcp/8000-8100, tcp/22@203.0.113.0/24 (source-restricted)")
    print("    tunnel ports are handled automatically - don't list them")
    if existing and e.get("services") is not None:
        sdef = list_str([x for x in e["services"] if (x["proto"], x["port"]) not in reserved])
    else:
        cand = [x for x in det["current_open"] if (x["proto"], x["port"]) not in reserved]
        for (p, n), proc in det["listening"].items():
            if proc.startswith("sshd") and (p, n) not in reserved:
                cand.append({"proto": p, "port": n})
        for n in det["ssh_ports"]:
            cand.append({"proto": "tcp", "port": n})
        sdef = list_str(merge_services(cand)) if cand else "tcp/22"
    cfg["services"] = ask_services(sdef, reserved, det["ssh_ports"])

    head("Outbound")
    print("    allowed outbound ports; the tunnels' own traffic is added automatically")
    edef = list_str(e["egress"]) if e.get("egress") else DEFAULT_EGRESS
    cfg["egress"] = ask("Allowed outbound", edef, lambda a: parse_list(a, "egress"))

    head("Policy")
    print("    accept = unlisted traffic is logged but let through (log only)")
    print("    drop   = unlisted traffic is blocked")
    cfg["policy"] = ask_choice("Policy for unlisted traffic", ["accept", "drop"], None)
    cfg["log"] = ask_yn("Log unlisted traffic", e.get("log", True))
    validate_config(cfg, "wizard")
    return cfg


def transport_line(role, r):
    other = other_role(role)
    who = {"both": "both listen", role: "this side listens",
           other: "upstream end listens" if role == "fe" else f"{other} listens"}[r["listener"]]
    pub = r.get("peer_public_ip")
    return (f"{'upstream' if role == 'fe' else 'transport'} tunnel {r['name']}: {r['type']} {r['dev']} {r['proto']}/{r['port']} ({who})  "
            f"{r['local_ip']} <-> {r['peer_ip']}"
            + ((f"  -> {pub}" if pub else "") if role == "fe" else f"  {other.upper()}={pub}" if pub else f"  {other.upper()}=any"))


def ingress_line(it):
    who = {"both": "both listen", "this": "this side listens", "prev": "downstream end listens"}[it["listener"]]
    return (f"downstream tunnel {it['name']}: {it['type']} {it['dev']} {it['proto']}/{it['port']} "
            f"({who})  {it['local_ip']} <-> {it['peer_ip']}" + (f"  -> {it['peer_public_ip']}" if it.get("peer_public_ip") else ""))


def clients_arrive(cfg):
    src = ([f"directly on {cfg['wan_if']}"] if cfg.get("direct_clients", True) else []) + \
          [f"through {d['name']} ({d['dev']})" for d in cfg.get("downstream_tunnels") or []]
    return " and ".join(src) if src else "nowhere"


def summarize(cfg):
    head("Summary")
    info(f"role {cfg['role']}, public iface {cfg['wan_if']}")
    for r in cfg["transports"]:
        info(transport_line(cfg["role"], r))
    if cfg["role"] == "fe":
        for d in cfg.get("downstream_tunnels") or []:
            info(ingress_line(d))
        info("clients arrive " + clients_arrive(cfg))
        info(f"forward to gateway: {list_str(cfg.get('forwards', []))}")
    else:
        for s in cfg["client_tunnels"]:
            via = ", ".join(r["name"] for r in ct_via(cfg, s)) if s.get("only_via_transport", True) else "anywhere"
            info(f"client tunnel {s['name']}: {s['type']} {s['dev']} {s['proto']}/{s['port']} {s['subnet']}  "
                 f"clients via {via}")
        info(f"joined client subnets: {', '.join(cfg['join_nets']) if cfg.get('join_nets') else 'none'}")
    info(f"open services: {list_str(cfg['services'])}")
    info(f"outbound allowed: {list_str(cfg['egress'])} (+tunnels)")
    info(f"policy: {cfg['policy']}" + (" (log only - nothing is blocked)" if cfg["policy"] == "accept" else "")
         + f"; logging {'on' if cfg.get('log', True) else 'off'}")
    info(f"DHCP rules: {'yes' if cfg.get('dhcp') else 'no'}")
    info(f"ip_forward: {'on' if wants_forwarding(cfg) else 'unchanged'}")


